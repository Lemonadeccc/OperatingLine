{
  "name": "operating-line",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lemonadeccc/OperatingLine.git"
  },
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --dir services/orchestrator dev",
    "dev:clients": "pnpm --dir services/cli-runtime dev",
    "dev:openai": "pnpm --dir services/openai-runtime dev",
    "youtube:auth": "tsx --env-file-if-exists=.env services/orchestrator/src/youtube-oauth-cli.ts",
    "setup:ai-clients": "tsx packages/client-setup/src/cli.ts --client all",
    "setup:codex": "tsx packages/client-setup/src/cli.ts --client codex",
    "setup:claude": "tsx packages/client-setup/src/cli.ts --client claude",
    "eval:snapshot": "tsx tools/eval/snapshot.ts",
    "eval:manifest": "tsx tools/eval/manifest.ts",
    "eval:capture": "tsx tools/eval/capture.ts",
    "eval:blind": "tsx tools/eval/blind.ts",
    "eval:review": "tsx services/eval-review/src/cli.ts",
    "eval:status": "tsx services/eval-review/src/status-cli.ts",
    "eval:recover-lock": "tsx tools/eval/recover-lock.ts",
    "eval:check": "tsx tools/eval/check.ts",
    "eval:release-check": "tsx tools/eval/release-check.ts",
    "eval:report": "tsx tools/eval/report.ts",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "schema:generate": "pnpm --filter @operatingline/protocol generate:schema",
    "schema:check": "pnpm --filter @operatingline/protocol check:schema",
    "changeset": "changeset",
    "release:status": "changeset status",
    "release:version": "changeset version",
    "release:check": "tsx tools/release/check-policy.ts && changeset status",
    "audit:prod": "pnpm audit --prod",
    "test": "vitest run",
    "test:watch": "vitest",
    "commit": "cz",
    "commitlint": "commitlint --edit",
    "package:blender": "node tools/blender/build-extension.mjs",
    "reproduce:youtube:965bgIUHoxA": "node tools/blender/generate-youtube-light-trails-pre-bake.mjs",
    "package:claude-desktop": "node tools/distribution/build-claude-desktop.mjs",
    "package:claude-desktop:dev-signed": "pnpm package:claude-desktop && node tools/distribution/sign-claude-desktop.mjs --mode development",
    "package:claude-desktop:signed": "pnpm package:claude-desktop && node tools/distribution/sign-claude-desktop.mjs --mode production",
    "test:blender": "node tools/blender/run-tests.mjs",
    "test:blender:companion": "tsx tools/blender/run-companion-e2e.mjs",
    "test:blender:leaf-reload-recovery": "tsx tools/blender/run-leaf-operation-reload-recovery-e2e.mjs",
    "test:blender:light-trails:companion": "tsx tools/blender/run-light-trails-leaf-operation-companion-e2e.mjs",
    "test:blender:pose-animation:companion": "tsx tools/blender/run-pose-animation-leaf-operation-companion-e2e.mjs",
    "test:blender:armature:companion": "tsx tools/blender/run-armature-leaf-operation-companion-e2e.mjs",
    "test:blender:skin-weights:companion": "tsx tools/blender/run-skin-weights-leaf-operation-companion-e2e.mjs",
    "test:blender:solidify:companion": "tsx tools/blender/run-solidify-leaf-operation-companion-e2e.mjs",
    "test:blender:bevel-modifier:companion": "tsx tools/blender/run-bevel-modifier-leaf-operation-companion-e2e.mjs",
    "test:blender:single-material:companion": "tsx tools/blender/run-single-material-leaf-operation-companion-e2e.mjs",
    "test:blender:material-palette:companion": "tsx tools/blender/run-material-palette-leaf-operation-companion-e2e.mjs",
    "test:blender:subdivision-surface:companion": "tsx tools/blender/run-subdivision-surface-leaf-operation-companion-e2e.mjs",
    "test:blender:edit-bevel:companion": "tsx tools/blender/run-edit-bevel-leaf-operation-companion-e2e.mjs",
    "test:blender:edit-inset:companion": "tsx tools/blender/run-edit-inset-leaf-operation-companion-e2e.mjs",
    "test:blender:edit-poke:companion": "tsx tools/blender/run-edit-poke-leaf-operation-companion-e2e.mjs",
    "test:blender:edit-triangulate:companion": "tsx tools/blender/run-edit-triangulate-leaf-operation-companion-e2e.mjs",
    "test:blender:edit-extrude-region:companion": "tsx tools/blender/run-edit-extrude-region-leaf-operation-companion-e2e.mjs",
    "test:blender:mirror:companion": "tsx tools/blender/run-mirror-leaf-operation-companion-e2e.mjs",
    "test:blender:menu-controls:companion": "tsx tools/blender/run-menu-control-companion-e2e.mjs",
    "test:blender:execution-track:companion": "tsx tools/blender/run-execution-track-companion-e2e.mjs",
    "test:blender:f9": "node tools/blender/run-icosphere-f9.mjs",
    "test:blender:subdivide": "node tools/blender/run-subdivide-f9.mjs",
    "test:blender:subdivide-candidate-menu": "node tools/blender/run-subdivide-f9.mjs --entry-mode=candidate-menu",
    "test:blender:subdivide-candidate-guidance": "node tools/blender/run-subdivide-candidate-guidance.mjs",
    "test:blender:subdivision-surface": "node tools/blender/run-subdivision-surface-f9.mjs",
    "test:blender:shortcut-history": "node tools/blender/run-shortcut-history.mjs",
    "test:blender:edit-bevel": "node tools/blender/run-edit-bevel-f9.mjs",
    "test:blender:edit-inset": "node tools/blender/run-edit-inset-f9.mjs",
    "test:blender:edit-poke": "node tools/blender/run-edit-poke-f9.mjs",
    "probe:blender:edit-poke-history": "node tools/blender/run-edit-poke-history-probe.mjs",
    "test:blender:poke-compound-proof": "tsx tools/blender/run-poke-compound-proof.mjs",
    "test:blender:poke-compound-process-recovery": "tsx tools/blender/run-poke-compound-process-recovery.mjs",
    "test:blender:poke-compound-transport-recovery": "tsx tools/blender/run-poke-compound-transport-recovery.mjs",
    "test:blender:mirror": "node tools/blender/run-mirror-ui.mjs",
    "test:blender:light-trails": "node tools/blender/run-light-trails-no-bake.mjs",
    "test:blender:youtube-light-trails": "node tools/blender/run-youtube-light-trails-pre-bake.mjs",
    "test:blender:menu-controls": "node tools/blender/run-uv-sphere-menu-controls.mjs",
    "test:blender:undo": "node tools/blender/run-native-undo.mjs",
    "test:blender:visual": "node tools/blender/capture-overlay.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm schema:check && pnpm release:check && pnpm format:check",
    "prepare": "husky"
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "2.1.2",
    "@changesets/cli": "3.0.0",
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@commitlint/cz-commitlint": "21.2.0",
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/client": "2.0.0",
    "@operatingline/blender-action-catalog": "workspace:*",
    "@operatingline/blender-mcp-bridge": "workspace:*",
    "@operatingline/cli-planner-provider": "workspace:*",
    "@operatingline/client-setup": "workspace:*",
    "@operatingline/domain": "workspace:*",
    "@operatingline/eval-kit": "workspace:*",
    "@operatingline/mcp-stdio-bridge": "workspace:*",
    "@operatingline/openai-planner-provider": "workspace:*",
    "@operatingline/orchestrator": "workspace:*",
    "@operatingline/persistence": "workspace:*",
    "@operatingline/protocol": "workspace:*",
    "@operatingline/test-kit": "workspace:*",
    "@types/node": "26.2.0",
    "commitizen": "4.3.2",
    "esbuild": "0.28.1",
    "eslint": "10.8.0",
    "husky": "9.1.7",
    "inquirer": "9.3.8",
    "prettier": "3.9.6",
    "tsx": "4.23.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vitest": "4.1.10",
    "yaml": "2.9.0"
  }
}
