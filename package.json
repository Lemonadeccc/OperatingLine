{
  "name": "operating-line",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lemonadeccc/OperatingLine.git"
  },
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --dir services/orchestrator dev",
    "dev:clients": "pnpm --dir services/cli-runtime dev",
    "dev:openai": "pnpm --dir services/openai-runtime dev",
    "setup:ai-clients": "tsx packages/client-setup/src/cli.ts --client all",
    "setup:codex": "tsx packages/client-setup/src/cli.ts --client codex",
    "setup:claude": "tsx packages/client-setup/src/cli.ts --client claude",
    "eval:snapshot": "tsx tools/eval/snapshot.ts",
    "eval:manifest": "tsx tools/eval/manifest.ts",
    "eval:capture": "tsx tools/eval/capture.ts",
    "eval:blind": "tsx tools/eval/blind.ts",
    "eval:review": "tsx services/eval-review/src/cli.ts",
    "eval:status": "tsx services/eval-review/src/status-cli.ts",
    "eval:recover-lock": "tsx tools/eval/recover-lock.ts",
    "eval:check": "tsx tools/eval/check.ts",
    "eval:report": "tsx tools/eval/report.ts",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "schema:generate": "pnpm --filter @operatingline/protocol generate:schema",
    "schema:check": "pnpm --filter @operatingline/protocol check:schema",
    "changeset": "changeset",
    "release:status": "changeset status",
    "release:version": "changeset version",
    "release:check": "tsx tools/release/check-policy.ts && changeset status",
    "audit:prod": "pnpm audit --prod",
    "test": "vitest run",
    "test:watch": "vitest",
    "commit": "cz",
    "commitlint": "commitlint --edit",
    "package:blender": "node tools/blender/build-extension.mjs",
    "package:claude-desktop": "node tools/distribution/build-claude-desktop.mjs",
    "package:claude-desktop:dev-signed": "pnpm package:claude-desktop && node tools/distribution/sign-claude-desktop.mjs --mode development",
    "package:claude-desktop:signed": "pnpm package:claude-desktop && node tools/distribution/sign-claude-desktop.mjs --mode production",
    "test:blender": "node tools/blender/run-tests.mjs",
    "test:blender:companion": "tsx tools/blender/run-companion-e2e.mjs",
    "test:blender:undo": "node tools/blender/run-native-undo.mjs",
    "test:blender:visual": "node tools/blender/capture-overlay.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm schema:check && pnpm release:check && pnpm format:check",
    "prepare": "husky"
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "2.1.2",
    "@changesets/cli": "3.0.0",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@commitlint/cz-commitlint": "21.2.2",
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/client": "2.0.0",
    "@operatingline/blender-action-catalog": "workspace:*",
    "@operatingline/blender-mcp-bridge": "workspace:*",
    "@operatingline/cli-planner-provider": "workspace:*",
    "@operatingline/client-setup": "workspace:*",
    "@operatingline/domain": "workspace:*",
    "@operatingline/eval-kit": "workspace:*",
    "@operatingline/mcp-stdio-bridge": "workspace:*",
    "@operatingline/openai-planner-provider": "workspace:*",
    "@operatingline/orchestrator": "workspace:*",
    "@operatingline/persistence": "workspace:*",
    "@operatingline/protocol": "workspace:*",
    "@operatingline/test-kit": "workspace:*",
    "@types/node": "24.13.3",
    "commitizen": "4.3.2",
    "esbuild": "0.28.2",
    "eslint": "10.8.1",
    "husky": "9.1.7",
    "inquirer": "9.3.8",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10",
    "yaml": "2.9.0"
  }
}
