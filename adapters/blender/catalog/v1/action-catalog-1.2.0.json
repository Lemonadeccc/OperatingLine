            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1000,
            "description": "Full edge length in Blender units."
          },
          "location": {
            "type": "array",
            "items": { "type": "number", "minimum": -1000, "maximum": 1000 },
            "minItems": 3,
            "maxItems": 3,
            "description": "World-space [x, y, z] center."
          }
        },
        "additionalProperties": false
      },
      "resourceEffects": [
        {
          "access": "create",
          "resourceType": "OBJECT",
          "argumentPath": "resourceId",
          "derivedResourceTypes": ["MESH"],
          "description": "Creates the object resource and a resourceId.mesh datablock."
        },
        {
          "access": "create",
          "resourceType": "COLLECTION",
          "argumentPath": "$managed.snowman.collection",
          "derivedResourceTypes": [],
          "description": "The first geometry action creates the shared managed collection if needed."
        }
      ],
      "supportedAnchorKinds": ["object", "world_position", "operator", "unavailable"],
      "supportedObservationKinds": ["resource_exists"],
      "rollbackModes": ["compensating_action"],
      "safety": {
        "sideEffect": "scene_write",
        "requiresPlanApproval": true,
        "networkAccess": false,
        "fileAccess": "none"
      }
    },
    {
      "name": "blender.mesh.create_primitive_batch",
      "title": "Create a primitive batch",
      "description": "Atomically creates 1 to 16 owned spheres, cones, or cylinders after validating all IDs and names.",
      "argumentsSchema": {
        "type": "object",
        "required": ["items"],
        "properties": {
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "uniqueResourceIds": true,
            "uniqueObjectNames": true,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "required": ["primitive", "resourceId", "objectName", "radius", "location"],
                  "properties": {
                    "primitive": { "enum": ["sphere", "uv_sphere"] },
                    "resourceId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
                    "objectName": {
                      "type": "string",
                      "pattern": "^OperatingLine\\.",
                      "maxLength": 180
                    },
                    "radius": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000 },
                    "location": {
                      "type": "array",
                      "items": { "type": "number", "minimum": -1000, "maximum": 1000 },
                      "minItems": 3,
                      "maxItems": 3
                    }
                  },
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "required": [
                    "primitive",
                    "resourceId",
                    "objectName",
                    "radiusStart",
                    "radiusEnd",
                    "start",
                    "end"
                  ],
                  "properties": {
                    "primitive": { "const": "cone" },
                    "resourceId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
                    "objectName": {
                      "type": "string",
                      "pattern": "^OperatingLine\\.",
                      "maxLength": 180
                    },
                    "radiusStart": { "type": "number", "minimum": 0, "maximum": 1000 },
                    "radiusEnd": { "type": "number", "minimum": 0, "maximum": 1000 },
                    "start": {
                      "type": "array",
                      "items": { "type": "number", "minimum": -1000, "maximum": 1000 },
                      "minItems": 3,
                      "maxItems": 3
                    },
                    "end": {
                      "type": "array",
                      "items": { "type": "number", "minimum": -1000, "maximum": 1000 },
                      "minItems": 3,
                      "maxItems": 3
                    }
                  },
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "required": ["primitive", "resourceId", "objectName", "radius", "start", "end"],
                  "properties": {
                    "primitive": { "const": "cylinder" },
                    "resourceId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
                    "objectName": {
                      "type": "string",
                      "pattern": "^OperatingLine\\.",
                      "maxLength": 180
                    },
                    "radius": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000 },
                    "start": {
                      "type": "array",
                      "items": { "type": "number", "minimum": -1000, "maximum": 1000 },
                      "minItems": 3,
                      "maxItems": 3
                    },
                    "end": {
                      "type": "array",
                      "items": { "type": "number", "minimum": -1000, "maximum": 1000 },
                      "minItems": 3,
                      "maxItems": 3
                    }
                  },
                  "additionalProperties": false
                }
              ]
            },
            "description": "start and end must differ; cone radii cannot both be zero."
          }
        },
        "additionalProperties": false
      },
      "resourceEffects": [
        {
          "access": "create",
          "resourceType": "OBJECT[]",
          "argumentPath": "items[].resourceId",
          "derivedResourceTypes": ["MESH[]"],
          "description": "Creates every object and its resourceId.mesh datablock atomically."
        },
        {
          "access": "create",
          "resourceType": "COLLECTION",
          "argumentPath": "$managed.snowman.collection",
          "derivedResourceTypes": [],
          "description": "The first geometry action creates the shared managed collection if needed."
        }
      ],
      "supportedAnchorKinds": ["object", "world_position", "operator", "unavailable"],
      "supportedObservationKinds": ["resource_exists"],
      "rollbackModes": ["compensating_action"],
      "safety": {
        "sideEffect": "scene_write",
        "requiresPlanApproval": true,
        "networkAccess": false,
        "fileAccess": "none"
      }
    },
    {
      "name": "blender.material.create_and_assign",
      "title": "Create and assign one material",
      "description": "Creates one owned Principled material and replaces material slots on 1 to 64 previously created owned mesh objects.",
      "argumentsSchema": {
        "type": "object",
        "required": ["materialId", "materialName", "targets", "baseColor", "roughness", "metallic"],
        "properties": {
          "materialId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
          "materialName": { "type": "string", "pattern": "^OperatingLine\\.", "maxLength": 180 },
          "targets": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
            "minItems": 1,
            "maxItems": 64,
            "uniqueItems": true,
            "description": "Logical IDs of owned mesh objects created by earlier actions."
          },
          "baseColor": {
            "type": "array",
            "items": { "type": "number", "minimum": 0, "maximum": 1 },
            "minItems": 4,
            "maxItems": 4,
            "description": "Linear RGBA channels in [0, 1]."
          },
          "roughness": { "type": "number", "minimum": 0, "maximum": 1 },
          "metallic": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "additionalProperties": false
      },
      "resourceEffects": [
        {
          "access": "create",
          "resourceType": "MATERIAL",
          "argumentPath": "materialId",
          "derivedResourceTypes": [],
          "description": "Creates one owned material."
        },
        {
          "access": "mutate",
          "resourceType": "OBJECT[]",
          "argumentPath": "targets[]",
          "derivedResourceTypes": [],
          "description": "Replaces the material slots of existing owned mesh targets with compare-and-restore rollback."
        }
      ],
      "supportedAnchorKinds": ["object", "operator", "unavailable"],
      "supportedObservationKinds": ["material_assigned"],
      "rollbackModes": ["compensating_action"],
      "safety": {
        "sideEffect": "scene_write",
        "requiresPlanApproval": true,
        "networkAccess": false,
        "fileAccess": "none"
      }
    },
    {
      "name": "blender.material.create_palette_and_assign",
      "title": "Create and assign a material palette",
      "description": "Atomically creates 1 to 8 owned Principled materials and assigns each target at most once.",
      "argumentsSchema": {
        "type": "object",
        "required": ["materials"],
        "properties": {
          "materials": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "object",
              "required": [
                "materialId",
                "materialName",
                "targets",
                "baseColor",
                "roughness",
                "metallic"
              ],
              "properties": {
                "materialId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
                "materialName": {
                  "type": "string",
                  "pattern": "^OperatingLine\\.",
                  "maxLength": 180
                },
                "targets": {
                  "type": "array",
                  "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
                  "minItems": 1,
                  "maxItems": 64,
                  "uniqueItems": true
                },
                "baseColor": {
                  "type": "array",
                  "items": { "type": "number", "minimum": 0, "maximum": 1 },
                  "minItems": 4,
                  "maxItems": 4
                },
                "roughness": { "type": "number", "minimum": 0, "maximum": 1 },
                "metallic": { "type": "number", "minimum": 0, "maximum": 1 }
              },
              "additionalProperties": false
            },
            "description": "materialId, materialName, and all targets must be unique across the palette."
          }
        },
        "additionalProperties": false
      },
      "resourceEffects": [
        {
          "access": "create",
          "resourceType": "MATERIAL[]",
          "argumentPath": "materials[].materialId",
          "derivedResourceTypes": [],
          "description": "Creates every palette material atomically."
        },
        {
          "access": "mutate",
          "resourceType": "OBJECT[]",
          "argumentPath": "materials[].targets[]",
          "derivedResourceTypes": [],
          "description": "Assigns the palette to previously created owned mesh objects."
        }
      ],
      "supportedAnchorKinds": ["object", "operator", "unavailable"],
      "supportedObservationKinds": ["material_assigned"],
      "rollbackModes": ["compensating_action"],
      "safety": {
        "sideEffect": "scene_write",
        "requiresPlanApproval": true,
        "networkAccess": false,
        "fileAccess": "none"
      }
    },
    {
      "name": "blender.rig.create_armature",
      "title": "Create and bind a rigid armature",
      "description": "Creates one owned armature with 1 to 32 bones and bone-parents previously created unparented owned objects while preserving their world transforms.",
      "argumentsSchema": {
        "type": "object",
        "required": ["armatureId", "objectName", "dataName", "collectionId", "bones", "bindings"],
        "properties": {
          "armatureId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "objectName": { "type": "string", "pattern": "^OperatingLine\\.", "maxLength": 180 },
          "dataName": { "type": "string", "pattern": "^OperatingLine\\.", "maxLength": 180 },
          "collectionId": { "const": "snowman.collection" },
          "bones": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "uniqueBoneNames": true,
            "acyclicParents": true,
            "items": {
              "type": "object",
              "required": ["boneName", "head", "tail", "parentName"],
              "properties": {
                "boneName": {
                  "type": "string",
                  "pattern": "^OperatingLine\\.",
                  "maxLength": 180
                },
                "head": {
                  "type": "array",
                  "items": { "type": "number", "minimum": -1000, "maximum": 1000 },
                  "minItems": 3,
                  "maxItems": 3
                },
                "tail": {
                  "type": "array",
                  "items": { "type": "number", "minimum": -1000, "maximum": 1000 },
                  "minItems": 3,
                  "maxItems": 3
                },
                "parentName": {
                  "anyOf": [
                    { "type": "string", "pattern": "^OperatingLine\\.", "maxLength": 180 },
                    { "type": "null" }
                  ]
                }
              },
              "additionalProperties": false
            },
            "description": "Bone head and tail must differ; every non-null parentName must reference another bone without forming a cycle."
          },
          "bindings": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "uniqueTargetIds": true,
            "items": {
              "type": "object",
              "required": ["targetId", "boneName"],
              "properties": {
                "targetId": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                },
                "boneName": {
                  "type": "string",
                  "pattern": "^OperatingLine\\.",
                  "maxLength": 180
                }
              },
              "additionalProperties": false
            },
            "description": "Each target must be an owned unparented object and each boneName must exist in bones."
          }
        },
        "additionalProperties": false
      },
      "resourceEffects": [
        {
          "access": "read",
          "resourceType": "COLLECTION",
          "argumentPath": "collectionId",
          "derivedResourceTypes": [],
          "description": "Requires the tracked adapter-managed collection."
        },
        {
          "access": "read",
          "resourceType": "OBJECT[]",
          "argumentPath": "bindings[].targetId",
          "derivedResourceTypes": [],
          "description": "Requires previously created owned, unparented objects."
        },
        {
          "access": "create",
          "resourceType": "ARMATURE_OBJECT",
          "argumentPath": "armatureId",
          "derivedResourceTypes": ["ARMATURE_DATA"],
          "description": "Creates the armature object and armatureId.data datablock."
        },
        {
          "access": "mutate",
          "resourceType": "OBJECT[]",
          "argumentPath": "bindings[].targetId",
          "derivedResourceTypes": [],
          "description": "Bone-parents the targets with compare-and-restore rollback."
        }
      ],
      "supportedAnchorKinds": ["object", "operator", "unavailable"],
      "supportedObservationKinds": ["armature_ready"],
      "rollbackModes": ["compensating_action"],
      "safety": {
        "sideEffect": "scene_write",
        "requiresPlanApproval": true,
        "networkAccess": false,
        "fileAccess": "none"
      }
    },
    {
      "name": "blender.animation.create_pose_keyframes",
      "title": "Create armature pose keyframes",
      "description": "Creates one owned Action and inserts bounded Euler-rotation keyframes on bones of a previously created owned armature.",
      "argumentsSchema": {
        "type": "object",
        "required": ["actionId", "actionName", "armatureId", "keyframes"],
        "properties": {
          "actionId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "actionName": { "type": "string", "pattern": "^OperatingLine\\.", "maxLength": 180 },
          "armatureId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "keyframes": {
            "type": "array",
            "minItems": 2,
            "maxItems": 64,
            "strictlyIncreasingFrames": true,
            "items": {
              "type": "object",
              "required": ["frame", "poses"],
              "properties": {
                "frame": { "type": "integer", "minimum": 1, "maximum": 100000 },
                "poses": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 32,
                  "uniqueBoneNames": true,
                  "items": {
                    "type": "object",
                    "required": ["boneName", "rotationEuler"],
                    "properties": {
                      "boneName": {
                        "type": "string",
                        "pattern": "^OperatingLine\\.",
                        "maxLength": 180
                      },
                      "rotationEuler": {
                        "type": "array",
                        "items": {
                          "type": "number",
                          "minimum": -6.283185307179586,
                          "maximum": 6.283185307179586
                        },
                        "minItems": 3,
                        "maxItems": 3
                      }
                    },
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      },
      "resourceEffects": [
        {
          "access": "read",
          "resourceType": "ARMATURE_OBJECT",
          "argumentPath": "armatureId",
          "derivedResourceTypes": [],
          "description": "Requires an owned armature created by an earlier catalog action."
        },
        {
          "access": "create",
          "resourceType": "ACTION",
          "argumentPath": "actionId",
          "derivedResourceTypes": [],
          "description": "Creates one owned Blender Action datablock."
        },
        {
          "access": "mutate",
          "resourceType": "POSE_BONE[]",
          "argumentPath": "keyframes[].poses[]",
          "derivedResourceTypes": [],
          "description": "Assigns the owned action and inserts bounded pose rotations with compensating rollback."
        }
      ],
      "supportedAnchorKinds": ["object", "operator", "unavailable"],
      "supportedObservationKinds": ["pose_animation_ready"],
      "rollbackModes": ["compensating_action"],
      "safety": {
        "sideEffect": "scene_write",
        "requiresPlanApproval": true,
        "networkAccess": false,
        "fileAccess": "none"
      }
    },
    {
      "name": "blender.render_scene.create",
      "title": "Create an isolated render scene",
      "description": "Creates an owned Scene and World, configures the world background, and links only the managed collection into the new scene.",
      "argumentsSchema": {
        "type": "object",
        "required": [
          "sceneId",
          "sceneName",
          "worldId",
          "worldName",
          "collectionId",
          "backgroundColor",
          "strength"
        ],
        "properties": {
          "sceneId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
          "sceneName": { "type": "string", "pattern": "^OperatingLine\\.", "maxLength": 180 },
          "worldId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
          "worldName": { "type": "string", "pattern": "^OperatingLine\\.", "maxLength": 180 },
          "collectionId": {
            "const": "snowman.collection",
            "description": "Current adapter-managed geometry collection."
          },
          "backgroundColor": {
            "type": "array",
            "items": { "type": "number", "minimum": 0, "maximum": 1 },
            "minItems": 4,
            "maxItems": 4
          },
          "strength": { "type": "number", "minimum": 0, "maximum": 1000 }
        },
        "additionalProperties": false
      },
      "resourceEffects": [
        {
          "access": "read",
          "resourceType": "COLLECTION",
          "argumentPath": "collectionId",
          "derivedResourceTypes": [],
          "description": "Requires the managed collection created by an earlier geometry action and rejects untracked contents."
        },
        {
          "access": "create",
          "resourceType": "SCENE",
          "argumentPath": "sceneId",
          "derivedResourceTypes": [],
          "description": "Creates an isolated render scene."
        },
        {
          "access": "create",
          "resourceType": "WORLD",
          "argumentPath": "worldId",
          "derivedResourceTypes": [],
          "description": "Creates and assigns a world to the new scene."
        }
      ],
      "supportedAnchorKinds": ["operator", "owned_control", "unavailable"],
      "supportedObservationKinds": ["render_scene_ready"],
      "rollbackModes": ["compensating_action"],
      "safety": {
        "sideEffect": "scene_write",
        "requiresPlanApproval": true,
        "networkAccess": false,
        "fileAccess": "none"
      }
    },
    {
      "name": "blender.render_rig.create",
      "title": "Create Area lights and a camera",
      "description": "Creates 1 to 4 owned Area lights and one owned camera in an existing isolated render scene.",
      "argumentsSchema": {
        "type": "object",
        "required": ["sceneId", "collectionId", "lights", "camera"],
        "properties": {
          "sceneId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
          "collectionId": { "const": "snowman.collection" },
          "lights": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {
              "type": "object",
              "required": [
                "resourceId",
                "objectName",
                "dataName",
                "location",
                "target",
                "color",
                "energy",
                "size"
              ],
              "properties": {
                "resourceId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
                "objectName": {
                  "type": "string",
                  "pattern": "^OperatingLine\\.",
                  "maxLength": 180
                },
                "dataName": { "type": "string", "pattern": "^OperatingLine\\.", "maxLength": 180 },
                "location": {
                  "type": "array",
                  "items": { "type": "number", "minimum": -1000, "maximum": 1000 },
                  "minItems": 3,
                  "maxItems": 3
                },
                "target": {
                  "type": "array",
                  "items": { "type": "number", "minimum": -1000, "maximum": 1000 },
                  "minItems": 3,
                  "maxItems": 3
                },
                "color": {
                  "type": "array",
                  "items": { "type": "number", "minimum": 0, "maximum": 1 },
                  "minItems": 3,
                  "maxItems": 3
                },
                "energy": { "type": "number", "minimum": 0, "maximum": 10000000 },
                "size": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000 }
              },
              "additionalProperties": false
            },
            "description": "Resource IDs, object names, and data names must be unique; location must differ from target."
          },
          "camera": {
            "type": "object",
            "required": ["resourceId", "objectName", "dataName", "location", "target", "lens"],
            "properties": {
              "resourceId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
              "objectName": { "type": "string", "pattern": "^OperatingLine\\.", "maxLength": 180 },
              "dataName": { "type": "string", "pattern": "^OperatingLine\\.", "maxLength": 180 },
              "location": {
                "type": "array",
                "items": { "type": "number", "minimum": -1000, "maximum": 1000 },
                "minItems": 3,
                "maxItems": 3
              },
              "target": {
                "type": "array",
                "items": { "type": "number", "minimum": -1000, "maximum": 1000 },
                "minItems": 3,
                "maxItems": 3
              },
              "lens": { "type": "number", "minimum": 1, "maximum": 1000 }
            },
            "additionalProperties": false,
            "description": "location must differ from target."
          }
        },
        "additionalProperties": false
      },
      "resourceEffects": [
        {
          "access": "read",
          "resourceType": "SCENE",
          "argumentPath": "sceneId",
          "derivedResourceTypes": [],
          "description": "Requires an isolated scene created by an earlier catalog action."
        },
        {
          "access": "read",
          "resourceType": "COLLECTION",
          "argumentPath": "collectionId",
          "derivedResourceTypes": [],
          "description": "Requires the managed collection linked into the scene."
        },
        {
          "access": "create",
          "resourceType": "LIGHT[]",
          "argumentPath": "lights[].resourceId",
          "derivedResourceTypes": ["LIGHT_DATA[]"],
          "description": "Creates Area light objects and resourceId.data datablocks."
        },
        {
          "access": "create",
          "resourceType": "CAMERA",
          "argumentPath": "camera.resourceId",
          "derivedResourceTypes": ["CAMERA_DATA"],
          "description": "Creates and activates the camera and its resourceId.data datablock."
        }
      ],
      "supportedAnchorKinds": ["object", "world_position", "operator", "unavailable"],
      "supportedObservationKinds": ["render_rig_ready"],
      "rollbackModes": ["compensating_action"],
      "safety": {
        "sideEffect": "scene_write",
        "requiresPlanApproval": true,
        "networkAccess": false,
        "fileAccess": "none"
      }
    },
    {
      "name": "blender.render.execute_preview",
      "title": "Render a managed PNG preview",
      "description": "Renders an existing owned scene to a PNG under the extension-managed temporary directory.",
      "argumentsSchema": {
        "type": "object",
        "required": [
          "renderId",
          "sceneId",
          "engine",
          "resolutionX",
          "resolutionY",
          "resolutionPercentage",
          "frame",
          "format",
          "destination",
          "samples"
        ],
        "properties": {
          "renderId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
          "sceneId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
          "engine": { "const": "auto_eevee" },
          "resolutionX": { "type": "integer", "minimum": 1, "maximum": 1024 },
          "resolutionY": { "type": "integer", "minimum": 1, "maximum": 1024 },
          "resolutionPercentage": { "type": "integer", "minimum": 1, "maximum": 100 },
          "frame": { "type": "integer", "minimum": 1, "maximum": 100000 },
          "format": { "const": "PNG" },
          "destination": { "const": "extension_temp" },
          "samples": { "type": "integer", "minimum": 1, "maximum": 128 }
        },
        "additionalProperties": false
      },
      "resourceEffects": [
        {
          "access": "read",
          "resourceType": "SCENE",
          "argumentPath": "sceneId",
          "derivedResourceTypes": [],
          "description": "Requires an owned scene with an active camera."
        },
        {
          "access": "artifact",
          "resourceType": "PNG",
          "argumentPath": "renderId",
          "derivedResourceTypes": [],
          "description": "Creates a digest-tracked PNG only inside the managed temporary output root."
        }
      ],
      "supportedAnchorKinds": ["operator", "owned_control", "unavailable"],
      "supportedObservationKinds": ["render_artifact_exists"],
      "rollbackModes": ["compensating_action"],
      "safety": {
        "sideEffect": "managed_file_write",
        "requiresPlanApproval": true,
        "networkAccess": false,
        "fileAccess": "managed_temp"
      }
    }
  ]
