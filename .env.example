# Local OperatingLine MCP/HTTP access. Replace with a random value of at least 16 characters.
OPERATINGLINE_ACCESS_TOKEN=replace-with-a-local-random-token

# Required only by the opt-in OpenAI runtime. Never commit a real key.
OPENAI_API_KEY=replace-with-your-openai-api-key
OPERATINGLINE_OPENAI_MODEL=replace-with-an-explicit-model-id

# Optional local runtime settings.
OPERATINGLINE_DATABASE_PATH=.data/operating-line-openai.db
OPERATINGLINE_PORT=0
OPERATINGLINE_MCP_URL=http://127.0.0.1:43123/mcp
