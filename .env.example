# Local OperatingLine MCP/HTTP access. Replace with a random value of at least 16 characters.
OPERATINGLINE_ACCESS_TOKEN=replace-with-a-local-random-token

# Optional local AI CLI runtime settings (`pnpm dev:clients`).
# OPERATINGLINE_CODEX_BIN=/absolute/path/to/codex
# OPERATINGLINE_CODEX_MODEL=replace-with-an-explicit-model-id
# OPERATINGLINE_CLAUDE_BIN=/absolute/path/to/claude
# OPERATINGLINE_CLAUDE_MODEL=replace-with-an-explicit-model-id
OPERATINGLINE_CLAUDE_MAX_BUDGET_USD=1.00
OPERATINGLINE_PLANNER_TIMEOUT_MS=120000

# Optional managed OAuth for official YouTube Data API caption import. Create a Google OAuth
# Desktop app client, then run `pnpm youtube:auth login`. The refresh token stays in the OS vault.
# OPERATINGLINE_YOUTUBE_OAUTH_CLIENT_ID=replace-with-your-desktop-client-id.apps.googleusercontent.com

# Legacy alternative: inject one short-lived access token. Do not set this together with the client id.
# The authenticated account must be able to edit the selected video. Never commit a real token.
# OPERATINGLINE_YOUTUBE_OAUTH_ACCESS_TOKEN=replace-with-a-short-lived-oauth-access-token

# Optional, fail-closed server-side YouTube tutorial media analysis. Every path must be a
# normalized absolute path. The authorization registry must be a regular file owned by the
# current user and inaccessible to group/other users (for example, mode 0600 on Unix).
# OPERATINGLINE_YOUTUBE_MEDIA_ROOT=/absolute/private/path/to/operatingline-youtube-media
# OPERATINGLINE_YOUTUBE_MEDIA_AUTHORIZATION_REGISTRY_PATH=/absolute/private/path/to/youtube-media-authorizations.json
# OPERATINGLINE_YT_DLP_BIN=/absolute/path/to/yt-dlp
# OPERATINGLINE_FFMPEG_BIN=/absolute/path/to/ffmpeg
# OPERATINGLINE_FFPROBE_BIN=/absolute/path/to/ffprobe
# OPERATINGLINE_WHISPER_CPP_BIN=/absolute/path/to/whisper-cli
# OPERATINGLINE_WHISPER_CPP_MODEL=/absolute/path/to/whisper-model.bin
# OPERATINGLINE_TESSERACT_BIN=/absolute/path/to/tesseract
# OPERATINGLINE_TESSDATA_DIR=/absolute/path/to/tessdata
# OPERATINGLINE_YOUTUBE_MEDIA_LOCALES=en
# OPERATINGLINE_YOUTUBE_MEDIA_FRAME_INTERVAL_MS=5000
# OPERATINGLINE_YOUTUBE_MEDIA_MAX_ANALYSIS_WINDOW_MS=14400000
# OPERATINGLINE_YOUTUBE_MEDIA_MAX_CONCURRENT_JOBS=1
# OPERATINGLINE_YOUTUBE_MEDIA_MAX_DOWNLOAD_BYTES=8589934592
# OPERATINGLINE_YOUTUBE_MEDIA_MAX_FRAMES=120
# OPERATINGLINE_YOUTUBE_MEDIA_MAX_JOB_RUNTIME_MS=7200000

# Required only by the opt-in OpenAI runtime. Never commit a real key.
OPENAI_API_KEY=replace-with-your-openai-api-key
OPERATINGLINE_OPENAI_MODEL=replace-with-an-explicit-model-id
# Optional: only enables evidence-bound Procedure semantic retrieval when explicitly configured.
# OPERATINGLINE_OPENAI_EMBEDDING_MODEL=replace-with-an-explicit-embedding-model-id

# Optional local runtime settings.
OPERATINGLINE_DATABASE_PATH=.data/operating-line.db
OPERATINGLINE_PORT=0
OPERATINGLINE_MCP_URL=http://127.0.0.1:43123/mcp
