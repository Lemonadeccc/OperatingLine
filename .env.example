# Local OperatingLine MCP/HTTP access. Replace with a random value of at least 16 characters.
OPERATINGLINE_ACCESS_TOKEN=replace-with-a-local-random-token

# Optional local AI CLI runtime settings (`pnpm dev:clients`).
# OPERATINGLINE_CODEX_BIN=/absolute/path/to/codex
# OPERATINGLINE_CODEX_MODEL=replace-with-an-explicit-model-id
# OPERATINGLINE_CLAUDE_BIN=/absolute/path/to/claude
# OPERATINGLINE_CLAUDE_MODEL=replace-with-an-explicit-model-id
OPERATINGLINE_CLAUDE_MAX_BUDGET_USD=1.00
OPERATINGLINE_PLANNER_TIMEOUT_MS=120000

# Optional managed OAuth for official YouTube Data API caption import. Create a Google OAuth
# Desktop app client, then run `pnpm youtube:auth login`. The refresh token stays in the OS vault.
# OPERATINGLINE_YOUTUBE_OAUTH_CLIENT_ID=replace-with-your-desktop-client-id.apps.googleusercontent.com

# Legacy alternative: inject one short-lived access token. Do not set this together with the client id.
# The authenticated account must be able to edit the selected video. Never commit a real token.
# OPERATINGLINE_YOUTUBE_OAUTH_ACCESS_TOKEN=replace-with-a-short-lived-oauth-access-token

# Required only by the opt-in OpenAI runtime. Never commit a real key.
OPENAI_API_KEY=replace-with-your-openai-api-key
OPERATINGLINE_OPENAI_MODEL=replace-with-an-explicit-model-id

# Optional local runtime settings.
OPERATINGLINE_DATABASE_PATH=.data/operating-line.db
OPERATINGLINE_PORT=0
OPERATINGLINE_MCP_URL=http://127.0.0.1:43123/mcp
