        },
        "observationPolicy": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "mode": {
                  "type": "string",
                  "const": "telemetry"
                }
              },
              "required": [
                "mode"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "mode": {
                  "type": "string",
                  "const": "success_gate"
                },
                "failureStrategy": {
                  "type": "string",
                  "enum": [
                    "rollback_step",
                    "retain_for_repair"
                  ]
                },
                "retryPolicy": {
                  "type": "object",
                  "properties": {
                    "mode": {
                      "type": "string",
                      "const": "automatic_bounded"
                    },
                    "maxAttempts": {
                      "type": "integer",
                      "minimum": 2,
                      "maximum": 3
                    }
                  },
                  "required": [
                    "mode",
                    "maxAttempts"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "mode",
                "failureStrategy"
              ],
              "additionalProperties": false,
              "allOf": [
                {
                  "if": {
                    "required": [
                      "retryPolicy"
                    ]
                  },
                  "then": {
                    "properties": {
                      "failureStrategy": {
                        "const": "rollback_step"
                      }
                    }
                  }
                }
              ]
            }
          ]
        },
        "rollback": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "native_undo",
                "checkpoint_restore",
                "compensating_action",
                "unsupported"
              ]
            },
            "checkpointRequired": {
              "type": "boolean"
            }
          },
          "required": [
            "mode",
            "checkpointRequired"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "parentId",
        "order",
        "dependsOn",
        "title",
        "intent",
        "explanation",
        "state",
        "action",
        "anchors",
        "expectedObservations",
        "rollback"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": [
              "observationPolicy"
            ]
          },
          "then": {
            "properties": {
              "action": {
                "type": "object"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "observationPolicy": {
                "properties": {
                  "mode": {
                    "const": "success_gate"
                  }
                },
                "required": [
                  "mode"
                ]
              }
            },
            "required": [
              "observationPolicy"
            ]
          },
          "then": {
            "properties": {
              "expectedObservations": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "requestedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "dispatchedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
