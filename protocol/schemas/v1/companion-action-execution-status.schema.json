            "draft",
            "ready",
            "running",
            "waiting_approval",
            "verifying",
            "succeeded",
            "failed",
            "stale",
            "rolled_back"
          ]
        },
        "action": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "adapterId": {
