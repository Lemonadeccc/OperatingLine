    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "required": [
    "formatVersion",
    "requestId",
    "replayId",
    "target",
    "proposalId",
    "plan",
    "planContentSha256",
    "executionId",
    "expectedState",
    "step",
    "requestedAt",
    "status",
    "updatedAt"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "properties": {
        "step": {
          "properties": {
            "action": {
              "type": "object",
              "properties": {
                "adapterId": {
                  "const": "blender"
                },
                "name": {
                  "enum": [
                    "blender.mesh.create_uv_sphere",
                    "blender.mesh.create_icosphere",
                    "blender.mesh.create_cube",
                    "blender.mesh.create_plane",
                    "blender.mesh.create_torus",
                    "blender.mesh.create_cone",
                    "blender.mesh.create_cylinder"
                  ]
                }
              },
              "required": [
                "adapterId",
                "name"
              ]
            }
          },
          "required": [
            "action"
          ]
        }
      },
      "required": [
        "step"
      ]
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "queued"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "deliveryId"
              ]
            },
            {
              "required": [
                "dispatchedAt"
              ]
            },
            {
              "required": [
                "result"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "dispatched",
              "recovery_required"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "deliveryId",
          "dispatchedAt"
        ],
        "not": {
          "required": [
            "result"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "succeeded"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
