                "required": [
                  "kind",
                  "reason"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "expectedObservations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "parameters": {
                "type": "object",
                "propertyNames": {
