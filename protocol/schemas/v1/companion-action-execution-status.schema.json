          },
          "then": {
            "properties": {
              "report": {
                "type": "object"
              },
              "error": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "failed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "report": {
                "type": "object"
              },
              "error": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "rejected"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "report": {
                "type": "null"
              },
              "error": {
                "type": "string",
                "minLength": 1
              }
            }
          }
