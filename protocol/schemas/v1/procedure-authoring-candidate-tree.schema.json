                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "unavailable"
                        },
                        "reason": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "kind",
                        "reason"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
