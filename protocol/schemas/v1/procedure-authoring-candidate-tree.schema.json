                        ],
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "mode",
                      "failureStrategy"
                    ],
                    "additionalProperties": false,
                    "allOf": [
                      {
                        "if": {
                          "required": [
                            "retryPolicy"
                          ]
                        },
                        "then": {
                          "properties": {
                            "failureStrategy": {
                              "const": "rollback_step"
                            }
                          }
                        }
                      }
                    ]
                  }
                ]
              },
              "rollback": {
