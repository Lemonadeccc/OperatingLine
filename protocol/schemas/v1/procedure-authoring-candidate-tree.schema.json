              "title",
              "intent",
              "kind",
              "action",
              "semanticOperations",
              "menuTracks",
              "shortcutTracks",
              "mcpTracks",
              "anchors",
              "expectedObservations",
              "rollback",
              "validation"
            ],
            "additionalProperties": false
          }
        ]
