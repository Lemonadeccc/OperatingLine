{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "type": "string",
      "enum": [
        "1.0.0",
        "1.1.0"
      ]
    },
    "targetAdapterId": {
      "type": "string",
      "minLength": 1
    },
    "goal": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "requestedPlanId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "recommendedRevision": {
      "anyOf": [
        {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "catalog": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "type": "string",
          "enum": [
            "1.0.0",
            "1.1.0"
          ]
        },
        "catalogVersion": {
          "type": "string",
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
        },
        "adapterId": {
          "type": "string",
          "minLength": 1
        },
        "adapterVersionRange": {
          "type": "string",
          "minLength": 1
        },
        "hostVersionRange": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "planningNotes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "planningPhases": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
              },
              "order": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "selectionGuidance": {
                "type": "string",
                "minLength": 1
              },
              "actionNames": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "id",
              "order",
              "title",
              "description",
              "selectionGuidance",
              "actionNames"
            ],
            "additionalProperties": false
          }
        },
        "actions": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "argumentsSchema": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "object"
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1
                  },
                  "required": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "properties": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {}
                  },
                  "additionalProperties": {
                    "type": "boolean",
                    "const": false
                  }
                },
                "required": [
                  "type",
                  "properties",
                  "additionalProperties"
                ],
                "additionalProperties": false
              },
              "resourceEffects": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "access": {
                      "type": "string",
                      "enum": [
                        "create",
                        "read",
                        "mutate",
                        "artifact"
                      ]
                    },
                    "resourceType": {
                      "type": "string",
                      "minLength": 1
                    },
                    "argumentPath": {
                      "type": "string",
                      "minLength": 1
                    },
                    "derivedResourceTypes": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "description": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "access",
                    "resourceType",
                    "argumentPath",
                    "derivedResourceTypes",
                    "description"
                  ],
                  "additionalProperties": false
                }
              },
              "supportedAnchorKinds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "object",
                    "world_position",
                    "operator",
                    "owned_control",
                    "unavailable"
                  ]
                }
              },
              "supportedObservationKinds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "rollbackModes": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "native_undo",
                    "checkpoint_restore",
                    "compensating_action",
                    "unsupported"
                  ]
                }
              },
              "safety": {
                "type": "object",
                "properties": {
                  "sideEffect": {
                    "type": "string",
                    "enum": [
                      "read",
                      "scene_write",
                      "managed_file_write"
                    ]
                  },
                  "requiresPlanApproval": {
                    "type": "boolean"
                  },
                  "networkAccess": {
                    "type": "boolean"
                  },
                  "fileAccess": {
                    "type": "string",
                    "enum": [
                      "none",
                      "managed_temp"
                    ]
                  }
                },
                "required": [
                  "sideEffect",
                  "requiresPlanApproval",
                  "networkAccess",
                  "fileAccess"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "name",
              "title",
              "description",
              "argumentsSchema",
              "resourceEffects",
              "supportedAnchorKinds",
              "supportedObservationKinds",
              "rollbackModes",
              "safety"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "protocolVersion",
        "catalogVersion",
        "adapterId",
        "adapterVersionRange",
        "hostVersionRange",
        "title",
        "description",
        "planningNotes",
        "actions"
      ],
      "additionalProperties": false
    },
    "companionStates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "protocolVersion": {
            "type": "string",
            "enum": [
              "1.0.0",
              "1.1.0"
            ]
          },
          "reportId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "sequence": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "adapterId": {
            "type": "string",
            "minLength": 1
          },
          "instanceId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "companionVersion": {
            "type": "string",
            "minLength": 1
          },
          "hostVersion": {
            "type": "string",
            "minLength": 1
          },
          "plan": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "revision": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "id",
                  "revision"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "phase": {
            "type": "string",
            "enum": [
              "idle",
              "ready",
              "running",
              "completed",
              "error"
            ]
          },
          "activeStepId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
              },
              {
                "type": "null"
              }
            ]
          },
          "completedStepIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            },
            "uniqueItems": true
          },
          "transition": {
            "type": "string",
            "enum": [
              "connected",
              "plan_loaded",
              "walkthrough_started",
              "step_succeeded",
              "step_rolled_back",
              "error"
            ]
          },
          "stepId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
              },
              {
                "type": "null"
              }
            ]
          },
          "observations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "minLength": 1
                },
                "satisfied": {
                  "type": "boolean"
                },
                "details": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                }
              },
              "required": [
                "kind",
                "satisfied",
                "details"
              ],
              "additionalProperties": false
            }
          },
          "error": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          }
        },
        "required": [
          "protocolVersion",
          "reportId",
          "sequence",
          "adapterId",
          "instanceId",
          "companionVersion",
          "hostVersion",
          "plan",
          "phase",
          "activeStepId",
          "completedStepIds",
          "transition",
          "stepId",
          "observations",
          "error",
          "occurredAt"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "transition": {
                  "enum": [
                    "step_succeeded",
                    "step_rolled_back"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "stepId": {
                  "type": "string"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "transition": {
                  "const": "error"
                }
              }
            },
            "then": {
              "properties": {
                "error": {
                  "type": "string"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "phase": {
                  "const": "error"
                }
              }
            },
            "then": {
              "properties": {
                "error": {
                  "type": "string"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "error": {
                  "type": "string"
                }
              }
            },
            "then": {
              "anyOf": [
                {
                  "properties": {
                    "transition": {
                      "const": "error"
                    }
                  }
                },
                {
                  "properties": {
                    "phase": {
                      "const": "error"
                    }
                  }
                }
              ]
            }
          },
          {
            "if": {
              "properties": {
                "phase": {
                  "enum": [
                    "ready",
                    "running",
                    "completed"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "plan": {
                  "type": "object"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "transition": {
                  "enum": [
                    "plan_loaded",
                    "walkthrough_started",
                    "step_succeeded",
                    "step_rolled_back"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "plan": {
                  "type": "object"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "activeStepId": {
                  "type": "string"
                }
              }
            },
            "then": {
              "properties": {
                "plan": {
                  "type": "object"
                }
              }
            }
          }
        ]
      }
    },
    "constraints": {
      "type": "object",
      "properties": {
        "singleAdapterPlan": {
          "type": "boolean",
          "const": true
        },
        "executableActionsMustBeLeaves": {
          "type": "boolean",
          "const": true
        },
        "dependenciesMustReferenceExecutableActions": {
          "type": "boolean",
          "const": true
        },
        "unknownActionsMustBeRejected": {
          "type": "boolean",
          "const": true
        },
        "semanticAnchorsOnly": {
          "type": "boolean",
          "const": true
        },
        "immutablePlanRevisions": {
          "type": "boolean",
          "const": true
        },
        "humanApprovalRequired": {
          "type": "boolean",
          "const": true
        },
        "executionOrder": {
          "type": "string",
          "const": "dependsOn_topology_then_order_then_id"
        }
      },
      "required": [
        "singleAdapterPlan",
        "executableActionsMustBeLeaves",
        "dependenciesMustReferenceExecutableActions",
        "unknownActionsMustBeRejected",
        "semanticAnchorsOnly",
        "immutablePlanRevisions",
        "humanApprovalRequired",
        "executionOrder"
      ],
      "additionalProperties": false
    },
    "submission": {
      "type": "object",
      "properties": {
        "toolName": {
          "type": "string",
          "const": "operatingline.guide.propose"
        },
        "targetAdapterId": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "toolName",
        "targetAdapterId",
        "description"
      ],
      "additionalProperties": false
    },
    "qualityGate": {
      "type": "object",
      "properties": {
        "toolName": {
          "type": "string",
          "const": "operatingline.planning.evaluate"
        },
        "baselineVersion": {
          "type": "string",
          "const": "1.0.0"
        },
        "requiredPhaseSelection": {
          "type": "string",
          "const": "planner_declared_from_goal"
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "toolName",
        "baselineVersion",
        "requiredPhaseSelection",
        "description"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "protocolVersion",
    "targetAdapterId",
    "goal",
    "requestedPlanId",
    "recommendedRevision",
    "catalog",
    "companionStates",
    "constraints",
    "submission"
  ],
  "additionalProperties": false,
  "$id": "https://operatingline.dev/schema/v1/planning-context.json"
}
