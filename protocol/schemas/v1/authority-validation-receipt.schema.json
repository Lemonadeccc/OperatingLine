{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "formatVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "receiptId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "authorityKind": {
      "type": "string",
      "enum": [
        "ProviderCallAuthorization",
        "LocalMediaImportAuthorization",
        "MediaRightsEvidence",
        "YouTubePlatformDownloadAuthorization",
        "DatasetReleaseAuthorization",
        "TrainingUseAuthorization"
      ]
    },
    "authorityId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "authorityContentSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "signerId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "keyId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "registryVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "validatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "revocationLogHeadSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "targetSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sideEffect": {
      "type": "string",
      "enum": [
        "provider_call",
        "local_media_import",
        "media_rights_validation",
        "youtube_platform_download",
        "dataset_release",
        "training_export"
      ]
    }
  },
  "required": [
    "formatVersion",
    "receiptId",
    "authorityKind",
    "authorityId",
    "authorityContentSha256",
    "signerId",
    "keyId",
    "registryVersion",
    "validatedAt",
    "revocationLogHeadSha256",
    "targetSha256",
    "sideEffect"
  ],
  "additionalProperties": false,
  "$id": "https://operatingline.dev/schema/v1/authority-validation-receipt.json"
}
