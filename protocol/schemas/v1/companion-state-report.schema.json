{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "type": "string",
      "enum": [
        "1.0.0",
        "1.1.0",
        "1.2.0",
        "1.3.0",
        "1.4.0",
        "1.5.0"
      ]
    },
    "reportId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "sequence": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "adapterId": {
      "type": "string",
      "minLength": 1
    },
    "instanceId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "companionVersion": {
      "type": "string",
      "minLength": 1
    },
    "hostVersion": {
      "type": "string",
      "minLength": 1
    },
    "plan": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "revision": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "id",
            "revision"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "planContentSha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "executionId": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        {
          "type": "null"
        }
      ]
    },
    "phase": {
      "type": "string",
      "enum": [
        "idle",
        "ready",
        "running",
        "blocked",
        "completed",
        "error"
      ]
    },
    "activeStepId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "completedStepIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
      },
      "uniqueItems": true
    },
    "transition": {
      "type": "string",
      "enum": [
        "connected",
        "plan_loaded",
        "walkthrough_started",
        "step_succeeded",
        "step_observation_failed",
        "observation_recovered",
        "step_rolled_back",
        "error"
      ]
    },
    "stepId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "satisfied": {
            "type": "boolean"
          },
          "details": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "required": [
          "kind",
          "satisfied",
          "details"
        ],
        "additionalProperties": false
      }
    },
    "observationGate": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "stepId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            },
            "status": {
              "type": "string",
              "enum": [
                "failed_rolled_back",
                "repair_required",
                "rollback_failed",
                "recovered"
              ]
            },
            "failureStrategy": {
              "type": "string",
              "enum": [
                "rollback_step",
                "retain_for_repair"
              ]
            },
            "message": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "stepId",
            "status",
            "failureStrategy",
            "message"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "status": {
                    "enum": [
                      "failed_rolled_back",
                      "rollback_failed"
                    ]
                  }
                },
                "required": [
                  "status"
                ]
              },
              "then": {
                "properties": {
                  "failureStrategy": {
                    "const": "rollback_step"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "repair_required"
                  }
                },
                "required": [
                  "status"
                ]
              },
              "then": {
                "properties": {
                  "failureStrategy": {
                    "const": "retain_for_repair"
                  }
                }
              }
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "artifactAttestation": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "formatVersion": {
              "type": "string",
              "const": "1.0.0"
            },
            "evidenceClass": {
              "type": "string",
              "const": "runtime_attested_host_artifacts"
            },
            "planContentSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "executionId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "hostProject": {
              "type": "object",
              "properties": {
                "artifactId": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                },
                "kind": {
                  "type": "string",
                  "const": "host_project"
                },
                "mediaType": {
                  "type": "string",
                  "const": "application/x-blender"
                },
                "contentSha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "artifactId",
                "kind",
                "mediaType",
                "contentSha256"
              ],
              "additionalProperties": false
            },
            "renderedImage": {
              "type": "object",
              "properties": {
                "artifactId": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                },
                "kind": {
                  "type": "string",
                  "const": "rendered_image"
                },
                "mediaType": {
                  "type": "string",
                  "const": "image/png"
                },
                "contentSha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "width": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 65536
                },
                "height": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 65536
                },
                "frame": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "renderEngine": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 180
                },
                "colorManagement": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                "hostProjectSha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "artifactId",
                "kind",
                "mediaType",
                "contentSha256",
                "width",
                "height",
                "frame",
                "renderEngine",
                "colorManagement",
                "hostProjectSha256"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "formatVersion",
            "evidenceClass",
            "planContentSha256",
            "executionId",
            "hostProject",
            "renderedImage"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "required": [
    "protocolVersion",
    "reportId",
    "sequence",
    "adapterId",
    "instanceId",
    "companionVersion",
    "hostVersion",
    "plan",
    "planContentSha256",
    "executionId",
    "phase",
    "activeStepId",
    "completedStepIds",
    "transition",
    "stepId",
    "observations",
    "error",
    "occurredAt"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "transition": {
            "enum": [
              "step_succeeded",
              "step_observation_failed",
              "observation_recovered",
              "step_rolled_back"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "stepId": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "transition": {
            "const": "error"
          }
        }
      },
      "then": {
        "properties": {
          "error": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "const": "error"
          }
        }
      },
      "then": {
        "properties": {
          "error": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "then": {
        "anyOf": [
          {
            "properties": {
              "transition": {
                "const": "error"
              }
            }
          },
          {
            "properties": {
              "phase": {
                "const": "error"
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "enum": [
              "ready",
              "running",
              "blocked",
              "completed"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "plan": {
            "type": "object"
          },
          "planContentSha256": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "transition": {
            "enum": [
              "plan_loaded",
              "walkthrough_started",
              "step_succeeded",
              "step_observation_failed",
              "observation_recovered",
              "step_rolled_back"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "plan": {
            "type": "object"
          },
          "planContentSha256": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "protocolVersion": {
            "enum": [
              "1.2.0",
              "1.3.0",
              "1.4.0",
              "1.5.0"
            ]
          }
        },
        "required": [
          "protocolVersion"
        ]
      },
      "then": {
        "required": [
          "observationGate"
        ]
      },
      "else": {
        "not": {
          "required": [
            "observationGate"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "protocolVersion": {
            "const": "1.5.0"
          }
        },
        "required": [
          "protocolVersion"
        ]
      },
      "then": {
        "required": [
          "artifactAttestation"
        ]
      },
      "else": {
        "not": {
          "required": [
            "artifactAttestation"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "artifactAttestation": {
            "type": "object"
          }
        },
        "required": [
          "artifactAttestation"
        ]
      },
      "then": {
        "properties": {
          "phase": {
            "enum": [
              "completed",
              "error"
            ]
          },
          "executionId": {
            "type": "string"
          },
          "planContentSha256": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "const": "blocked"
          }
        },
        "required": [
          "phase"
        ]
      },
      "then": {
        "required": [
          "observationGate"
        ],
        "properties": {
          "observationGate": {
            "type": "object",
            "properties": {
              "status": {
                "enum": [
                  "repair_required",
                  "rollback_failed"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "transition": {
            "const": "step_observation_failed"
          }
        },
        "required": [
          "transition"
        ]
      },
      "then": {
        "required": [
          "observationGate"
        ],
        "properties": {
          "observationGate": {
            "type": "object"
          },
          "observations": {
            "minItems": 1,
            "contains": {
              "type": "object",
              "properties": {
                "satisfied": {
                  "const": false
                }
              },
              "required": [
                "satisfied"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "transition": {
            "const": "observation_recovered"
          }
        },
        "required": [
          "transition"
        ]
      },
      "then": {
        "required": [
          "observationGate"
        ],
        "properties": {
          "observationGate": {
            "type": "object",
            "properties": {
              "status": {
                "const": "recovered"
              }
            }
          },
          "observations": {
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "satisfied": {
                  "const": true
                }
              },
              "required": [
                "satisfied"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "activeStepId": {
            "type": "string"
          }
        }
      },
      "then": {
        "properties": {
          "plan": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "plan": {
            "type": "null"
          }
        },
        "required": [
          "plan"
        ]
      },
      "then": {
        "properties": {
          "planContentSha256": {
            "type": "null"
          },
          "executionId": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "planContentSha256": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "executionId": {
            "type": "string"
          }
        }
      },
      "then": {
        "properties": {
          "plan": {
            "type": "object"
          },
          "planContentSha256": {
            "type": "string"
          }
        }
      }
    }
  ],
  "$id": "https://operatingline.dev/schema/v1/companion-state-report.json"
}
