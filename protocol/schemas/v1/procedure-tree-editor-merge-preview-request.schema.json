{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "formatVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "requestId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "targetBranchId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "sourceBranchId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "targetHead": {
      "type": "object",
      "properties": {
        "treeId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "revision": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "contentSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "treeId",
        "revision",
        "contentSha256"
      ],
      "additionalProperties": false
    },
    "sourceHead": {
      "type": "object",
      "properties": {
        "treeId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "revision": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "contentSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "treeId",
        "revision",
        "contentSha256"
      ],
      "additionalProperties": false
    },
    "expectedLatestRevision": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "resolutions": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "conflict": {
            "type": "object",
            "properties": {
              "stableId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
              },
              "path": {
                "minItems": 1,
                "maxItems": 32,
                "type": "array",
                "items": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "field"
                        },
                        "name": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 180
                        }
                      },
                      "required": [
                        "kind",
                        "name"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "identified"
                        },
                        "collection": {
                          "type": "string",
                          "enum": [
                            "sources",
                            "evidence",
                            "nodes",
                            "semanticOperations",
                            "menuTracks",
                            "shortcutTracks",
                            "mcpTracks",
                            "operations",
                            "anchors",
                            "expectedObservations"
                          ]
                        },
                        "id": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                        }
                      },
                      "required": [
                        "kind",
                        "collection",
                        "id"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "mergeBase": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "present": {
                        "type": "boolean",
                        "const": true
                      },
                      "value": {
                        "$ref": "#/$defs/__schema0"
                      }
                    },
                    "required": [
                      "present",
                      "value"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "present": {
                        "type": "boolean",
                        "const": false
                      }
                    },
                    "required": [
                      "present"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "target": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "present": {
                        "type": "boolean",
                        "const": true
                      },
                      "value": {
                        "$ref": "#/$defs/__schema0"
                      }
                    },
                    "required": [
                      "present",
                      "value"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "present": {
                        "type": "boolean",
                        "const": false
                      }
                    },
                    "required": [
                      "present"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "source": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "present": {
                        "type": "boolean",
                        "const": true
                      },
                      "value": {
                        "$ref": "#/$defs/__schema0"
                      }
                    },
                    "required": [
                      "present",
                      "value"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "present": {
                        "type": "boolean",
                        "const": false
                      }
                    },
                    "required": [
                      "present"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            },
            "required": [
              "stableId",
              "path",
              "mergeBase",
              "target",
              "source"
            ],
            "additionalProperties": false
          },
          "choice": {
            "type": "string",
            "enum": [
              "target",
              "source",
              "base",
              "custom"
            ]
          },
          "custom": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "present": {
                    "type": "boolean",
                    "const": true
                  },
                  "value": {
                    "$ref": "#/$defs/__schema0"
                  }
                },
                "required": [
                  "present",
                  "value"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "present": {
                    "type": "boolean",
                    "const": false
                  }
                },
                "required": [
                  "present"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "conflict",
          "choice"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "choice": {
                  "const": "custom"
                }
              },
              "required": [
                "choice"
              ]
            },
            "then": {
              "required": [
                "custom"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "custom"
                ]
              }
            }
          }
        ]
      }
    }
  },
  "required": [
    "formatVersion",
    "requestId",
    "targetBranchId",
    "sourceBranchId",
    "targetHead",
    "sourceHead",
    "expectedLatestRevision"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  },
  "$id": "https://operatingline.dev/schema/v1/procedure-tree-editor-merge-preview-request.json"
}
