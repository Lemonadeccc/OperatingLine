{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "catalogVersion": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
    },
    "adapterId": {
      "type": "string",
      "minLength": 1
    },
    "adapterVersionRange": {
      "type": "string",
      "minLength": 1
    },
    "hostVersionRange": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "planningNotes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "actions": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "argumentsSchema": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "object"
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "required": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "properties": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              },
              "additionalProperties": {
                "type": "boolean",
                "const": false
              }
            },
            "required": [
              "type",
              "properties",
              "additionalProperties"
            ],
            "additionalProperties": false
          },
          "resourceEffects": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "access": {
                  "type": "string",
                  "enum": [
                    "create",
                    "read",
                    "mutate",
                    "artifact"
                  ]
                },
                "resourceType": {
                  "type": "string",
                  "minLength": 1
                },
                "argumentPath": {
                  "type": "string",
                  "minLength": 1
                },
                "derivedResourceTypes": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "access",
                "resourceType",
                "argumentPath",
                "derivedResourceTypes",
                "description"
              ],
              "additionalProperties": false
            }
          },
          "supportedAnchorKinds": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "object",
                "world_position",
                "operator",
                "owned_control",
                "unavailable"
              ]
            }
          },
          "supportedObservationKinds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "rollbackModes": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "native_undo",
                "checkpoint_restore",
                "compensating_action",
                "unsupported"
              ]
            }
          },
          "safety": {
            "type": "object",
            "properties": {
              "sideEffect": {
                "type": "string",
                "enum": [
                  "read",
                  "scene_write",
                  "managed_file_write"
                ]
              },
              "requiresPlanApproval": {
                "type": "boolean"
              },
              "networkAccess": {
                "type": "boolean"
              },
              "fileAccess": {
                "type": "string",
                "enum": [
                  "none",
                  "managed_temp"
                ]
              }
            },
            "required": [
              "sideEffect",
              "requiresPlanApproval",
              "networkAccess",
              "fileAccess"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "name",
          "title",
          "description",
          "argumentsSchema",
          "resourceEffects",
          "supportedAnchorKinds",
          "supportedObservationKinds",
          "rollbackModes",
          "safety"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "protocolVersion",
    "catalogVersion",
    "adapterId",
    "adapterVersionRange",
    "hostVersionRange",
    "title",
    "description",
    "planningNotes",
    "actions"
  ],
  "additionalProperties": false,
  "$id": "https://operatingline.dev/schema/v1/action-catalog.json"
}
