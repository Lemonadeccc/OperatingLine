{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "const": "native_history_rebind"
    },
    "formatVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "requestId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "replayId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "proofId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "deliveryId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "target": {
      "type": "object",
      "properties": {
        "adapterId": {
          "type": "string",
          "const": "blender"
        },
        "instanceId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        }
      },
      "required": [
        "adapterId",
        "instanceId"
      ],
      "additionalProperties": false
    },
    "bindingContentSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "recoveryId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "history": {
      "type": "object",
      "properties": {
        "checkpointId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "undoLockId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "checkpointKind": {
          "type": "string",
          "enum": [
            "success",
            "failure"
          ]
        },
        "baselineSceneFingerprintSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "lockedSceneFingerprintSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "terminalResultContentSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "checkpointId",
        "undoLockId",
        "checkpointKind",
        "baselineSceneFingerprintSha256",
        "lockedSceneFingerprintSha256",
        "terminalResultContentSha256"
      ],
      "additionalProperties": false
    },
    "status": {
      "type": "string",
      "enum": [
        "succeeded",
        "failed_checkpointed",
        "restored",
        "reapplied_locked"
      ]
    },
    "expectedMarkerContentSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "currentSceneFingerprintSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "mutationLocked": {
      "type": "boolean"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "required": [
    "kind",
    "formatVersion",
    "requestId",
    "replayId",
    "proofId",
    "deliveryId",
    "target",
    "bindingContentSha256",
    "recoveryId",
    "history",
    "status",
    "expectedMarkerContentSha256",
    "currentSceneFingerprintSha256",
    "mutationLocked",
    "occurredAt"
  ],
  "additionalProperties": false,
  "$id": "https://operatingline.dev/schema/v1/companion-shortcut-proof-recovery-ack.json"
}
