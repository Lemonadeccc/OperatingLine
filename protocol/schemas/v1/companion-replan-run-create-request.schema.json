{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "generationRequestId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "revisionRequestId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "providerId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "providerVersion": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
    },
    "targetAdapterId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180
    },
    "targetInstanceId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "authorization": {
      "type": "object",
      "properties": {
        "disclosureVersion": {
          "type": "string",
          "const": "1.0.0"
        },
        "dataHandlingAcknowledged": {
          "type": "boolean",
          "const": true
        },
        "possibleChargesAcknowledged": {
          "type": "boolean",
          "const": true
        },
        "proposalCreationAcknowledged": {
          "type": "boolean",
          "const": true
        },
        "authorizedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        }
      },
      "required": [
        "disclosureVersion",
        "dataHandlingAcknowledged",
        "possibleChargesAcknowledged",
        "proposalCreationAcknowledged",
        "authorizedAt"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "generationRequestId",
    "revisionRequestId",
    "providerId",
    "providerVersion",
    "targetAdapterId",
    "targetInstanceId",
    "authorization"
  ],
  "additionalProperties": false,
  "$id": "https://operatingline.dev/schema/v1/companion-replan-run-create-request.json"
}
