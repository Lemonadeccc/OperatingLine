{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "formatVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "generationId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "requestId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "provider": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "packetFormatVersion": {
      "type": "string",
      "enum": [
        "1.0.0",
        "1.1.0"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "ready",
        "needs_revision"
      ]
    },
    "draft": {
      "type": "object",
      "properties": {
        "targetAdapterId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "catalogVersion": {
          "type": "string",
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
        },
        "planning": {
          "type": "object",
          "properties": {
            "goal": {
              "type": "string",
              "minLength": 1,
              "maxLength": 10000
            },
            "requiredPhaseIds": {
              "minItems": 1,
              "maxItems": 64,
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
              }
            },
            "capabilityCoverage": {
              "type": "object",
              "properties": {
                "policyVersion": {
                  "type": "string",
                  "const": "catalog_capability_coverage_v1"
                },
                "requirements": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "requirementId": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                      },
                      "statement": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 10000
                      },
                      "coverage": {
                        "minItems": 1,
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "capabilityId": {
                              "type": "string",
                              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                            },
                            "stepIds": {
                              "minItems": 1,
                              "type": "array",
                              "items": {
                                "type": "string",
                                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                              }
                            }
                          },
                          "required": [
                            "capabilityId",
                            "stepIds"
                          ],
                          "additionalProperties": false
                        }
                      }
                    },
                    "required": [
                      "requirementId",
                      "statement",
                      "coverage"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "policyVersion",
                "requirements"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "goal",
            "requiredPhaseIds"
          ],
          "additionalProperties": false
        },
        "plan": {
          "type": "object",
          "properties": {
            "protocolVersion": {
              "type": "string",
              "enum": [
                "1.0.0",
                "1.1.0",
                "1.2.0",
                "1.3.0",
                "1.4.0"
              ]
            },
            "id": {
              "type": "string",
              "minLength": 1
            },
            "revision": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "rootStepId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            },
            "steps": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                  },
                  "parentId": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "order": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "dependsOn": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                    }
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "intent": {
                    "type": "string",
                    "minLength": 1
                  },
                  "explanation": {
                    "type": "string",
                    "minLength": 1
                  },
                  "state": {
                    "type": "string",
                    "enum": [
                      "draft",
                      "ready",
                      "running",
                      "waiting_approval",
                      "verifying",
                      "succeeded",
                      "failed",
                      "stale",
                      "rolled_back"
                    ]
                  },
                  "action": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "adapterId": {
                            "type": "string",
                            "minLength": 1
                          },
                          "name": {
                            "type": "string",
                            "minLength": 1
                          },
                          "arguments": {
                            "type": "object",
                            "propertyNames": {
                              "type": "string"
                            },
                            "additionalProperties": {}
                          }
                        },
                        "required": [
                          "adapterId",
                          "name",
                          "arguments"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "anchors": {
                    "type": "array",
                    "items": {
                      "oneOf": [
                        {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "type": "string",
                              "const": "object"
                            },
                            "objectName": {
                              "type": "string",
                              "minLength": 1
                            }
                          },
                          "required": [
                            "kind",
                            "objectName"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "type": "string",
                              "const": "world_position"
                            },
                            "position": {
                              "minItems": 3,
                              "maxItems": 3,
                              "type": "array",
                              "items": {
                                "type": "number"
                              }
                            }
                          },
                          "required": [
                            "kind",
                            "position"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "type": "string",
                              "const": "operator"
                            },
                            "operatorId": {
                              "type": "string",
                              "minLength": 1
                            },
                            "menuPath": {
                              "type": "array",
                              "items": {
                                "type": "string",
                                "minLength": 1
                              }
                            }
                          },
                          "required": [
                            "kind",
                            "operatorId"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "type": "string",
                              "const": "owned_control"
                            },
                            "surfaceId": {
                              "type": "string",
                              "minLength": 1
                            },
                            "controlId": {
                              "type": "string",
                              "minLength": 1
                            }
                          },
                          "required": [
                            "kind",
                            "surfaceId",
                            "controlId"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "type": "string",
                              "const": "unavailable"
                            },
                            "reason": {
                              "type": "string",
                              "minLength": 1
                            }
                          },
                          "required": [
                            "kind",
                            "reason"
                          ],
                          "additionalProperties": false
                        }
                      ]
                    }
                  },
                  "expectedObservations": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "minLength": 1
                        },
                        "parameters": {
                          "type": "object",
                          "propertyNames": {
                            "type": "string"
                          },
                          "additionalProperties": {}
                        }
                      },
                      "required": [
                        "kind",
                        "parameters"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "observationPolicy": {
                    "oneOf": [
                      {
                        "type": "object",
                        "properties": {
                          "mode": {
                            "type": "string",
                            "const": "telemetry"
                          }
                        },
                        "required": [
                          "mode"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "mode": {
                            "type": "string",
                            "const": "success_gate"
                          },
                          "failureStrategy": {
                            "type": "string",
                            "enum": [
                              "rollback_step",
                              "retain_for_repair"
                            ]
                          }
                        },
                        "required": [
                          "mode",
                          "failureStrategy"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  },
                  "rollback": {
                    "type": "object",
                    "properties": {
                      "mode": {
                        "type": "string",
                        "enum": [
                          "native_undo",
                          "checkpoint_restore",
                          "compensating_action",
                          "unsupported"
                        ]
                      },
                      "checkpointRequired": {
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "mode",
                      "checkpointRequired"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "id",
                  "parentId",
                  "order",
                  "dependsOn",
                  "title",
                  "intent",
                  "explanation",
                  "state",
                  "action",
                  "anchors",
                  "expectedObservations",
                  "rollback"
                ],
                "additionalProperties": false,
                "allOf": [
                  {
                    "if": {
                      "required": [
                        "observationPolicy"
                      ]
                    },
                    "then": {
                      "properties": {
                        "action": {
                          "type": "object"
                        }
                      }
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "observationPolicy": {
                          "properties": {
                            "mode": {
                              "const": "success_gate"
                            }
                          },
                          "required": [
                            "mode"
                          ]
                        }
                      },
                      "required": [
                        "observationPolicy"
                      ]
                    },
                    "then": {
                      "properties": {
                        "expectedObservations": {
                          "minItems": 1
                        }
                      }
                    }
                  }
                ]
              }
            }
          },
          "required": [
            "protocolVersion",
            "id",
            "revision",
            "title",
            "rootStepId",
            "steps"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "protocolVersion": {
                    "enum": [
                      "1.2.0",
                      "1.3.0",
                      "1.4.0"
                    ]
                  }
                },
                "required": [
                  "protocolVersion"
                ]
              },
              "else": {
                "properties": {
                  "steps": {
                    "items": {
                      "not": {
                        "required": [
                          "observationPolicy"
                        ]
                      }
                    }
                  }
                }
              }
            }
          ]
        }
      },
      "required": [
        "targetAdapterId",
        "catalogVersion",
        "planning",
        "plan"
      ],
      "additionalProperties": false
    },
    "planningQuality": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "type": "string",
          "enum": [
            "1.0.0",
            "1.1.0",
            "1.2.0",
            "1.3.0",
            "1.4.0"
          ]
        },
        "baselineVersion": {
          "type": "string",
          "enum": [
            "1.0.0",
            "1.1.0"
          ]
        },
        "targetAdapterId": {
          "type": "string",
          "minLength": 1
        },
        "catalogVersion": {
          "type": "string",
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
        },
        "goal": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "plan": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "revision": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "id",
            "revision"
          ],
          "additionalProperties": false
        },
        "requiredPhaseIds": {
          "maxItems": 64,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          }
        },
        "valid": {
          "type": "boolean"
        },
        "summary": {
          "type": "object",
          "properties": {
            "errorCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "warningCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "executableStepCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "groupStepCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "usedPhaseCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "requiredPhaseCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "errorCount",
            "warningCount",
            "executableStepCount",
            "groupStepCount",
            "usedPhaseCount",
            "requiredPhaseCount"
          ],
          "additionalProperties": false
        },
        "phases": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "phaseId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
              },
              "order": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "required": {
                "type": "boolean"
              },
              "used": {
                "type": "boolean"
              },
              "groupStepIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                }
              },
              "actionStepIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                }
              }
            },
            "required": [
              "phaseId",
              "order",
              "title",
              "required",
              "used",
              "groupStepIds",
              "actionStepIds"
            ],
            "additionalProperties": false
          }
        },
        "capabilityCoverage": {
          "type": "object",
          "properties": {
            "policyVersion": {
              "type": "string",
              "const": "catalog_capability_coverage_v1"
            },
            "requirements": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "requirementId": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                  },
                  "statement": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 10000
                  },
                  "coverage": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "capabilityId": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                        },
                        "stepIds": {
                          "minItems": 1,
                          "type": "array",
                          "items": {
                            "type": "string",
                            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                          }
                        }
                      },
                      "required": [
                        "capabilityId",
                        "stepIds"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "requirementId",
                  "statement",
                  "coverage"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "policyVersion",
            "requirements"
          ],
          "additionalProperties": false
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "severity": {
                "type": "string",
                "enum": [
                  "error",
                  "warning"
                ]
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "stepIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                }
              },
              "phaseIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                }
              }
            },
            "required": [
              "code",
              "severity",
              "message",
              "stepIds",
              "phaseIds"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "protocolVersion",
        "baselineVersion",
        "targetAdapterId",
        "catalogVersion",
        "goal",
        "plan",
        "requiredPhaseIds",
        "valid",
        "summary",
        "phases",
        "findings"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": {
              "baselineVersion": {
                "const": "1.0.0"
              }
            },
            "required": [
              "baselineVersion"
            ]
          },
          "then": {
            "not": {
              "type": "object",
              "required": [
                "capabilityCoverage"
              ]
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "baselineVersion": {
                "const": "1.1.0"
              }
            },
            "required": [
              "baselineVersion"
            ]
          },
          "then": {
            "type": "object",
            "if": {
              "type": "object",
              "required": [
                "capabilityCoverage"
              ]
            },
            "then": {
              "type": "object",
              "properties": {
                "findings": {
                  "type": "array",
                  "not": {
                    "contains": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "const": "coverage.missing"
                        },
                        "severity": {
                          "const": "error"
                        }
                      },
                      "required": [
                        "code",
                        "severity"
                      ]
                    }
                  }
                }
              }
            },
            "else": {
              "type": "object",
              "properties": {
                "valid": {
                  "const": false
                },
                "findings": {
                  "type": "array",
                  "contains": {
                    "type": "object",
                    "properties": {
                      "code": {
                        "const": "coverage.missing"
                      },
                      "severity": {
                        "const": "error"
                      }
                    },
                    "required": [
                      "code",
                      "severity"
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    },
    "proposalCreated": {
      "type": "boolean",
      "const": false
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "durationMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "formatVersion",
    "generationId",
    "requestId",
    "provider",
    "packetFormatVersion",
    "status",
    "draft",
    "planningQuality",
    "proposalCreated",
    "generatedAt",
    "durationMs"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "packetFormatVersion": {
            "const": "1.0.0"
          }
        },
        "required": [
          "packetFormatVersion"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "planningQuality": {
            "type": "object",
            "properties": {
              "baselineVersion": {
                "const": "1.0.0"
              }
            },
            "required": [
              "baselineVersion"
            ]
          }
        }
      },
      "else": {
        "type": "object",
        "properties": {
          "planningQuality": {
            "type": "object",
            "properties": {
              "baselineVersion": {
                "const": "1.1.0"
              }
            },
            "required": [
              "baselineVersion"
