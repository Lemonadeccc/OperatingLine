                },
                "required": [
                  "stepId",
                  "nodeNumber",
                  "parentId",
                  "order",
                  "title"
                ],
                "additionalProperties": false
              },
              "changes": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "field": {
                      "type": "string",
                      "enum": [
                        "parentId",
                        "order",
                        "dependsOn",
                        "title",
                        "intent",
                        "explanation",
                        "state",
                        "action",
                        "anchors",
                        "expectedObservations",
                        "rollback"
                      ]
                    },
                    "before": {
                      "$ref": "#/$defs/__schema2"
                    },
                    "after": {
                      "$ref": "#/$defs/__schema3"
                    }
                  },
                  "required": [
                    "field",
                    "before",
                    "after"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "kind",
              "stepId",
              "before",
              "after",
              "changes"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
