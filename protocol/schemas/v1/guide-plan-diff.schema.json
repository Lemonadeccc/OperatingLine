                "required": [
                  "stepId",
                  "nodeNumber",
                  "parentId",
                  "order",
                  "title"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "kind",
              "stepId",
              "before"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "updated"
              },
              "stepId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
              },
