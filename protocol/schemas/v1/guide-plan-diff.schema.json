    "basePlan": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "id",
        "revision"
      ],
      "additionalProperties": false
    },
    "targetPlan": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "id",
        "revision"
      ],
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "properties": {
        "planFields": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "addedSteps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "removedSteps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "updatedSteps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "movedSteps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "planFields",
        "addedSteps",
        "removedSteps",
        "updatedSteps",
        "movedSteps"
      ],
      "additionalProperties": false
    },
    "planChanges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "enum": [
              "title",
              "rootStepId"
            ]
          },
          "before": {
            "$ref": "#/$defs/__schema0"
          },
          "after": {
            "$ref": "#/$defs/__schema1"
          }
        },
        "required": [
          "field",
          "before",
          "after"
        ],
        "additionalProperties": false
      }
    },
    "stepChanges": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "added"
              },
              "stepId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
              },
              "after": {
                "type": "object",
                "properties": {
                  "stepId": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                  },
                  "nodeNumber": {
                    "type": "string",
                    "pattern": "^[1-9]\\d*(?:\\.[1-9]\\d*)*$"
                  },
                  "parentId": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "order": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
