                  },
                  "parentId": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "order": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "stepId",
                  "nodeNumber",
                  "parentId",
                  "order",
                  "title"
                ],
                "additionalProperties": false
              },
              "after": {
                "type": "object",
                "properties": {
                  "stepId": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                  },
                  "nodeNumber": {
                    "type": "string",
