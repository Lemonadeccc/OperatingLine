                      "type": "string",
                      "enum": [
                        "object",
                        "world_position",
                        "operator",
                        "owned_control",
                        "unavailable"
                      ]
                    }
                  },
                  "supportedObservationKinds": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "rollbackModes": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "native_undo",
                        "checkpoint_restore",
                        "compensating_action",
                        "unsupported"
                      ]
                    }
                  },
                  "safety": {
                    "type": "object",
                    "properties": {
                      "sideEffect": {
                        "type": "string",
                        "enum": [
                          "read",
                          "scene_write",
                          "managed_file_write"
                        ]
                      },
                      "requiresPlanApproval": {
                        "type": "boolean"
                      },
                      "networkAccess": {
                        "type": "boolean"
                      },
                      "fileAccess": {
                        "type": "string",
                        "enum": [
                          "none",
                          "managed_temp"
                        ]
                      }
                    },
                    "required": [
                      "sideEffect",
                      "requiresPlanApproval",
                      "networkAccess",
                      "fileAccess"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "name",
                  "title",
                  "description",
                  "argumentsSchema",
                  "resourceEffects",
                  "supportedAnchorKinds",
                  "supportedObservationKinds",
                  "rollbackModes",
                  "safety"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "protocolVersion",
            "catalogVersion",
            "adapterVersionRange",
            "hostVersionRange",
            "title",
            "description",
            "planningNotes",
            "actions"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "type": "object",
                "required": [
                  "semanticCapabilities"
                ]
              },
              "then": {
                "type": "object",
                "required": [
                  "planningPhases"
                ]
              }
            }
          ]
        },
        "interactionCatalog": {
          "type": "object",
          "properties": {
            "protocolVersion": {
              "type": "string",
              "enum": [
                "1.0.0",
                "1.1.0",
                "1.2.0",
                "1.3.0",
                "1.4.0",
                "1.5.0"
              ]
            },
            "catalogVersion": {
              "type": "string",
              "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
            },
            "adapterVersionRange": {
              "type": "string",
              "pattern": "^(?:(?:>=|<=|>|<|=)?(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)(?: (?:>=|<=|>|<|=)?(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*))*)(?: \\|\\| (?:(?:>=|<=|>|<|=)?(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)(?: (?:>=|<=|>|<|=)?(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*))*))*$"
            },
            "hostVersionRange": {
              "type": "string",
              "pattern": "^(?:(?:>=|<=|>|<|=)?(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)(?: (?:>=|<=|>|<|=)?(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*))*)(?: \\|\\| (?:(?:>=|<=|>|<|=)?(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)(?: (?:>=|<=|>|<|=)?(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*))*))*$"
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string",
              "minLength": 1
            },
            "recipes": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                  },
                  "actionName": {
                    "type": "string",
                    "minLength": 1
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "guidance": {
                    "oneOf": [
                      {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "const": "native_path"
                          },
                          "surfaceId": {
                            "type": "string",
                            "minLength": 1
                          },
                          "preconditions": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "kind": {
                                  "type": "string",
                                  "enum": [
                                    "workspace",
                                    "editor",
                                    "mode",
                                    "selection"
                                  ]
                                },
                                "label": {
                                  "type": "string",
                                  "minLength": 1
                                },
                                "value": {
                                  "type": "string",
                                  "minLength": 1
                                }
                              },
                              "required": [
                                "kind",
                                "label",
                                "value"
                              ],
                              "additionalProperties": false
                            }
                          },
                          "steps": {
                            "minItems": 2,
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "id": {
                                  "type": "string",
                                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                                },
                                "order": {
                                  "type": "integer",
                                  "exclusiveMinimum": 0,
                                  "maximum": 9007199254740991
                                },
                                "label": {
                                  "type": "string",
                                  "minLength": 1
                                },
                                "intent": {
                                  "type": "string",
                                  "enum": [
                                    "navigate",
                                    "configure",
                                    "execute",
                                    "verify"
                                  ]
                                },
                                "target": {
                                  "type": "object",
                                  "properties": {
                                    "kind": {
                                      "type": "string",
                                      "enum": [
                                        "workspace",
                                        "editor",
                                        "mode",
                                        "menu",
                                        "menu_item",
                                        "operator",
                                        "control",
                                        "panel",
                                        "node",
                                        "socket",
                                        "canvas",
                                        "semantic"
                                      ]
                                    },
                                    "hostId": {
                                      "type": "string",
                                      "minLength": 1
                                    }
                                  },
                                  "required": [
                                    "kind",
                                    "hostId"
                                  ],
                                  "additionalProperties": false
                                }
                              },
                              "required": [
                                "id",
                                "order",
                                "label",
                                "intent",
                                "target"
                              ],
                              "additionalProperties": false
                            }
                          },
                          "execution": {
                            "type": "object",
                            "properties": {
                              "stepId": {
                                "type": "string",
                                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                              },
                              "operatorId": {
                                "type": "string",
                                "minLength": 1
                              },
                              "binding": {
                                "type": "string",
                                "const": "accepted_plan_action"
                              }
                            },
                            "required": [
                              "stepId",
                              "operatorId",
                              "binding"
                            ],
                            "additionalProperties": false
                          },
                          "manualReference": {
                            "type": "string",
                            "format": "uri"
                          }
                        },
                        "required": [
                          "kind",
                          "surfaceId",
                          "preconditions",
                          "steps",
                          "execution"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "const": "semantic_path"
                          },
                          "steps": {
                            "minItems": 1,
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "id": {
                                  "type": "string",
                                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                                },
                                "order": {
                                  "type": "integer",
                                  "exclusiveMinimum": 0,
                                  "maximum": 9007199254740991
                                },
                                "label": {
                                  "type": "string",
                                  "minLength": 1
                                },
                                "intent": {
                                  "type": "string",
                                  "enum": [
                                    "navigate",
                                    "configure",
                                    "execute",
                                    "verify"
                                  ]
                                },
                                "target": {
                                  "type": "object",
                                  "properties": {
                                    "kind": {
                                      "type": "string",
                                      "enum": [
                                        "workspace",
                                        "editor",
                                        "mode",
                                        "menu",
                                        "menu_item",
                                        "operator",
                                        "control",
                                        "panel",
                                        "node",
                                        "socket",
                                        "canvas",
                                        "semantic"
                                      ]
                                    },
                                    "hostId": {
                                      "type": "string",
                                      "minLength": 1
                                    }
                                  },
                                  "required": [
                                    "kind",
                                    "hostId"
                                  ],
                                  "additionalProperties": false
                                }
                              },
                              "required": [
                                "id",
                                "order",
                                "label",
                                "intent",
                                "target"
                              ],
                              "additionalProperties": false
                            }
                          },
                          "reason": {
                            "type": "string",
                            "minLength": 1
                          },
                          "manualReference": {
                            "type": "string",
                            "format": "uri"
                          }
                        },
                        "required": [
                          "kind",
                          "steps",
                          "reason"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  }
                },
                "required": [
                  "id",
                  "actionName",
                  "title",
                  "guidance"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "protocolVersion",
            "catalogVersion",
            "adapterVersionRange",
            "hostVersionRange",
            "title",
            "description",
            "recipes"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "adapterId",
        "actionCatalog",
        "interactionCatalog"
      ],
      "additionalProperties": false
    },
    "constraints": {
      "type": "object",
      "properties": {
        "allGeneratedLeavesCandidate": {
          "type": "boolean",
          "const": true
        },
        "validatedHostVersionsEmpty": {
          "type": "boolean",
          "const": true
        },
        "exactParametersRemainOnSemanticOperations": {
          "type": "boolean",
          "const": true
        },
        "allInteractionTracksUnavailable": {
          "type": "boolean",
          "const": true
        },
        "persistenceRequiresExplicitStore": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "allGeneratedLeavesCandidate",
        "validatedHostVersionsEmpty",
        "exactParametersRemainOnSemanticOperations",
        "allInteractionTracksUnavailable",
        "persistenceRequiresExplicitStore"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "requestedTreeId",
    "recommendedRevision",
    "goalProvenance",
    "catalogBinding",
    "constraints"
  ],
  "additionalProperties": false,
  "$id": "https://operatingline.dev/schema/v1/procedure-authoring-prompt-context.json"
}
