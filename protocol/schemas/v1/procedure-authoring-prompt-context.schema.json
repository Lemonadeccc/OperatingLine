{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "requestedTreeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "recommendedRevision": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "goalProvenance": {
      "type": "object",
      "properties": {
        "source": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            },
            "kind": {
              "type": "string",
              "const": "natural_language"
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 10000,
              "pattern": "\\S"
            },
            "locale": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^\\S+$"
            }
          },
          "required": [
            "id",
            "kind",
            "text"
          ],
          "additionalProperties": false
        },
        "evidence": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            },
            "locator": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "whole_source"
                }
              },
              "required": [
                "kind"
              ],
              "additionalProperties": false
            },
            "description": {
              "type": "string",
              "minLength": 1
            },
            "confidence": {
              "type": "number",
              "const": 1
            }
          },
          "required": [
            "id",
            "locator",
            "description",
            "confidence"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "source",
        "evidence"
      ],
      "additionalProperties": false
    },
    "catalogBinding": {
      "type": "object",
      "properties": {
        "adapterId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180,
          "pattern": "^\\S+$"
        },
        "actionCatalog": {
          "type": "object",
          "properties": {
            "protocolVersion": {
              "type": "string",
              "enum": [
                "1.0.0",
                "1.1.0",
                "1.2.0",
                "1.3.0",
                "1.4.0",
                "1.5.0"
              ]
            },
            "catalogVersion": {
              "type": "string",
              "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
            },
            "adapterVersionRange": {
              "type": "string",
              "pattern": "^(?:(?:>=|<=|>|<|=)?(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)(?: (?:>=|<=|>|<|=)?(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*))*)(?: \\|\\| (?:(?:>=|<=|>|<|=)?(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)(?: (?:>=|<=|>|<|=)?(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*))*))*$"
            },
            "hostVersionRange": {
              "type": "string",
              "pattern": "^(?:(?:>=|<=|>|<|=)?(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)(?: (?:>=|<=|>|<|=)?(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*))*)(?: \\|\\| (?:(?:>=|<=|>|<|=)?(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)(?: (?:>=|<=|>|<|=)?(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*))*))*$"
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string",
              "minLength": 1
            },
            "planningNotes": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "planningPhases": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                  },
                  "order": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1
                  },
                  "selectionGuidance": {
                    "type": "string",
                    "minLength": 1
                  },
                  "actionNames": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "required": [
                  "id",
                  "order",
                  "title",
                  "description",
                  "selectionGuidance",
                  "actionNames"
                ],
                "additionalProperties": false
              }
            },
            "semanticCapabilities": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1
                  },
                  "selectionGuidance": {
                    "type": "string",
                    "minLength": 1
                  },
                  "actionNames": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "required": [
                  "id",
                  "title",
                  "description",
                  "selectionGuidance",
                  "actionNames"
                ],
                "additionalProperties": false
              }
            },
            "actions": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1
                  },
                  "argumentsSchema": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "object"
                      },
                      "description": {
                        "type": "string",
                        "minLength": 1
                      },
                      "distinctPropertyValues": {
                        "minItems": 2,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "atLeastOnePositiveProperty": {
                        "minItems": 1,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "properties": {
                        "type": "object",
                        "propertyNames": {
                          "type": "string"
                        },
                        "additionalProperties": {}
                      },
                      "additionalProperties": {
                        "type": "boolean",
                        "const": false
                      }
                    },
                    "required": [
                      "type",
                      "properties",
                      "additionalProperties"
                    ],
                    "additionalProperties": false
                  },
                  "resourceEffects": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "access": {
                          "type": "string",
                          "enum": [
                            "create",
                            "read",
                            "mutate",
                            "artifact"
                          ]
                        },
                        "resourceType": {
                          "type": "string",
                          "minLength": 1
                        },
                        "argumentPath": {
                          "type": "string",
                          "minLength": 1
                        },
                        "derivedResourceTypes": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "description": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "access",
                        "resourceType",
                        "argumentPath",
                        "derivedResourceTypes",
                        "description"
                      ],
                      "additionalProperties": false
