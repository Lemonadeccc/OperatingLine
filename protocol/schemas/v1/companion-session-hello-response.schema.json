{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contractVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "leaseId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "negotiatedGuideProtocolVersion": {
      "type": "string",
      "enum": [
        "1.0.0",
        "1.1.0",
        "1.2.0",
        "1.3.0",
        "1.4.0",
        "1.5.0"
      ]
    },
    "catalogVersion": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "presentation": {
          "type": "object",
          "properties": {
            "taskTree": {
              "type": "string",
              "enum": [
                "native",
                "emulated",
                "unsupported"
              ]
            },
            "viewportOverlay": {
              "type": "string",
              "enum": [
                "native",
                "emulated",
                "unsupported"
              ]
            },
            "interactiveAnchors": {
              "type": "string",
              "enum": [
                "native",
                "emulated",
                "unsupported"
              ]
            }
          },
          "required": [
            "taskTree",
            "viewportOverlay",
            "interactiveAnchors"
          ],
          "additionalProperties": false
        },
        "execution": {
          "type": "object",
          "properties": {
            "inspect": {
              "type": "string",
              "enum": [
                "native",
                "emulated",
                "unsupported"
              ]
            },
            "invokeActions": {
              "type": "string",
              "enum": [
                "native",
                "emulated",
                "unsupported"
              ]
            },
            "screenshot": {
              "type": "string",
              "enum": [
                "native",
                "emulated",
                "unsupported"
              ]
            },
            "rollbackModes": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "native_undo",
                  "checkpoint_restore",
                  "compensating_action",
                  "unsupported"
                ]
              }
            }
          },
          "required": [
            "inspect",
            "invokeActions",
            "screenshot",
            "rollbackModes"
          ],
          "additionalProperties": false
        },
        "runtime": {
          "type": "object",
          "properties": {
            "dispatch": {
              "type": "string",
              "enum": [
                "main_thread_serial",
                "host_managed",
                "external_process"
              ]
            },
            "network": {
              "type": "string",
              "enum": [
                "native",
                "emulated",
                "unsupported"
              ]
            },
            "persistentProjectState": {
              "type": "string",
              "enum": [
                "native",
                "emulated",
                "unsupported"
              ]
            }
          },
          "required": [
            "dispatch",
            "network",
            "persistentProjectState"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "presentation",
        "execution",
        "runtime"
      ],
      "additionalProperties": false
    },
    "heartbeatIntervalMs": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "leaseTtlMs": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "required": [
    "contractVersion",
    "leaseId",
    "negotiatedGuideProtocolVersion",
    "catalogVersion",
    "capabilities",
    "heartbeatIntervalMs",
    "leaseTtlMs",
    "expiresAt"
  ],
  "additionalProperties": false,
  "$id": "https://operatingline.dev/schema/v1/companion-session-hello-response.json"
}
