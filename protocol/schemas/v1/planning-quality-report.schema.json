{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "type": "string",
      "enum": [
        "1.0.0",
        "1.1.0"
      ]
    },
    "baselineVersion": {
      "type": "string",
      "enum": [
        "1.0.0",
        "1.1.0"
      ]
    },
    "targetAdapterId": {
      "type": "string",
      "minLength": 1
    },
    "catalogVersion": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
    },
    "goal": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "plan": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "id",
        "revision"
      ],
      "additionalProperties": false
    },
    "requiredPhaseIds": {
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
      }
    },
    "valid": {
      "type": "boolean"
    },
    "summary": {
      "type": "object",
      "properties": {
        "errorCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "warningCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "executableStepCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "groupStepCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "usedPhaseCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "requiredPhaseCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "errorCount",
        "warningCount",
        "executableStepCount",
        "groupStepCount",
        "usedPhaseCount",
        "requiredPhaseCount"
      ],
      "additionalProperties": false
    },
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "phaseId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "order": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          },
          "used": {
            "type": "boolean"
          },
          "groupStepIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            }
          },
          "actionStepIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            }
          }
        },
        "required": [
          "phaseId",
          "order",
          "title",
          "required",
          "used",
          "groupStepIds",
          "actionStepIds"
        ],
        "additionalProperties": false
      }
    },
    "capabilityCoverage": {
      "type": "object",
      "properties": {
        "policyVersion": {
          "type": "string",
          "const": "catalog_capability_coverage_v1"
        },
        "requirements": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "requirementId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
              },
              "statement": {
                "type": "string",
                "minLength": 1,
                "maxLength": 10000
              },
              "coverage": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "capabilityId": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                    },
                    "stepIds": {
                      "minItems": 1,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                      }
                    }
                  },
                  "required": [
                    "capabilityId",
                    "stepIds"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "requirementId",
              "statement",
              "coverage"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "policyVersion",
        "requirements"
      ],
      "additionalProperties": false
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "type": "string",
            "enum": [
              "error",
              "warning"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "stepIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            }
          },
          "phaseIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            }
          }
        },
        "required": [
          "code",
          "severity",
          "message",
          "stepIds",
          "phaseIds"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "protocolVersion",
    "baselineVersion",
    "targetAdapterId",
    "catalogVersion",
    "goal",
    "plan",
    "requiredPhaseIds",
    "valid",
    "summary",
    "phases",
    "findings"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "baselineVersion": {
            "const": "1.0.0"
          }
        },
        "required": [
          "baselineVersion"
        ]
      },
      "then": {
        "not": {
          "type": "object",
          "required": [
            "capabilityCoverage"
          ]
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "baselineVersion": {
            "const": "1.1.0"
          }
        },
        "required": [
          "baselineVersion"
        ]
      },
      "then": {
        "type": "object",
        "if": {
          "type": "object",
          "required": [
            "capabilityCoverage"
          ]
        },
        "then": {
          "type": "object",
          "properties": {
            "findings": {
              "type": "array",
              "not": {
                "contains": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "const": "coverage.missing"
                    },
                    "severity": {
                      "const": "error"
                    }
                  },
                  "required": [
                    "code",
                    "severity"
                  ]
                }
              }
            }
          }
        },
        "else": {
          "type": "object",
          "properties": {
            "valid": {
              "const": false
            },
            "findings": {
              "type": "array",
              "contains": {
                "type": "object",
                "properties": {
                  "code": {
                    "const": "coverage.missing"
                  },
                  "severity": {
                    "const": "error"
                  }
                },
                "required": [
                  "code",
                  "severity"
                ]
              }
            }
          }
        }
      }
    }
  ],
  "$id": "https://operatingline.dev/schema/v1/planning-quality-report.json"
}
