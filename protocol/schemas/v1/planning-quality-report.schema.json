{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "type": "string",
      "enum": [
        "1.0.0",
        "1.1.0"
      ]
    },
    "baselineVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "targetAdapterId": {
      "type": "string",
      "minLength": 1
    },
    "catalogVersion": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
    },
    "goal": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "plan": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "id",
        "revision"
      ],
      "additionalProperties": false
    },
    "requiredPhaseIds": {
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
      }
    },
    "valid": {
      "type": "boolean"
    },
    "summary": {
      "type": "object",
      "properties": {
        "errorCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "warningCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "executableStepCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "groupStepCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "usedPhaseCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "requiredPhaseCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "errorCount",
        "warningCount",
        "executableStepCount",
        "groupStepCount",
        "usedPhaseCount",
        "requiredPhaseCount"
      ],
      "additionalProperties": false
    },
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "phaseId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "order": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          },
          "used": {
            "type": "boolean"
          },
          "groupStepIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            }
          },
          "actionStepIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            }
          }
        },
        "required": [
          "phaseId",
          "order",
          "title",
          "required",
          "used",
          "groupStepIds",
          "actionStepIds"
        ],
        "additionalProperties": false
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "type": "string",
            "enum": [
              "error",
              "warning"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "stepIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            }
          },
          "phaseIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            }
          }
        },
        "required": [
          "code",
          "severity",
          "message",
          "stepIds",
          "phaseIds"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "protocolVersion",
    "baselineVersion",
    "targetAdapterId",
    "catalogVersion",
    "goal",
    "plan",
    "requiredPhaseIds",
    "valid",
    "summary",
    "phases",
    "findings"
  ],
  "additionalProperties": false,
  "$id": "https://operatingline.dev/schema/v1/planning-quality-report.json"
}
