{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "targetAdapterId": {
      "type": "string",
      "minLength": 1
    },
    "plan": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "type": "string",
          "const": "1.0.0"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "rootStepId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "steps": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
              },
              "parentId": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "order": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "dependsOn": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                }
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "intent": {
                "type": "string",
                "minLength": 1
              },
              "explanation": {
                "type": "string",
                "minLength": 1
              },
              "state": {
                "type": "string",
                "enum": [
                  "draft",
                  "ready",
                  "running",
                  "waiting_approval",
                  "verifying",
                  "succeeded",
                  "failed",
                  "stale",
                  "rolled_back"
                ]
              },
              "action": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "adapterId": {
                        "type": "string",
                        "minLength": 1
                      },
                      "name": {
                        "type": "string",
                        "minLength": 1
                      },
                      "arguments": {
                        "type": "object",
                        "propertyNames": {
                          "type": "string"
                        },
                        "additionalProperties": {}
                      }
                    },
                    "required": [
                      "adapterId",
                      "name",
                      "arguments"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "anchors": {
                "type": "array",
                "items": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "object"
                        },
                        "objectName": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "kind",
                        "objectName"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "world_position"
                        },
                        "position": {
                          "minItems": 3,
                          "maxItems": 3,
                          "type": "array",
                          "items": {
                            "type": "number"
                          }
                        }
                      },
                      "required": [
                        "kind",
                        "position"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "operator"
                        },
                        "operatorId": {
                          "type": "string",
                          "minLength": 1
                        },
                        "menuPath": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          }
                        }
                      },
                      "required": [
                        "kind",
                        "operatorId"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "owned_control"
                        },
                        "surfaceId": {
                          "type": "string",
                          "minLength": 1
                        },
                        "controlId": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "kind",
                        "surfaceId",
                        "controlId"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "unavailable"
                        },
                        "reason": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "kind",
                        "reason"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "expectedObservations": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "minLength": 1
                    },
                    "parameters": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {}
                    }
                  },
                  "required": [
                    "kind",
                    "parameters"
                  ],
                  "additionalProperties": false
                }
              },
              "rollback": {
                "type": "object",
                "properties": {
                  "mode": {
                    "type": "string",
                    "enum": [
                      "native_undo",
                      "checkpoint_restore",
                      "compensating_action",
                      "unsupported"
                    ]
                  },
                  "checkpointRequired": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "mode",
                  "checkpointRequired"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "parentId",
              "order",
              "dependsOn",
              "title",
              "intent",
              "explanation",
              "state",
              "action",
              "anchors",
              "expectedObservations",
              "rollback"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "protocolVersion",
        "id",
        "revision",
        "title",
        "rootStepId",
        "steps"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "targetAdapterId",
    "plan"
  ],
  "additionalProperties": false,
  "$id": "https://operatingline.dev/schema/v1/guide-proposal-submission.json"
}
