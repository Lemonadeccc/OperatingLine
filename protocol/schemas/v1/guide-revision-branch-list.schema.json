{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "type": "string",
      "const": "1.5.0"
    },
    "targetAdapterId": {
      "type": "string",
      "minLength": 1
    },
    "instanceId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "planId": {
      "type": "string",
      "minLength": 1
    },
    "branches": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "threadId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "headRequestId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "headTurn": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "status": {
            "type": "string",
            "enum": [
              "awaiting_proposal",
              "awaiting_decision",
              "accepted",
              "rejected"
            ]
          },
          "operation": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "revise"
                  }
                },
                "required": [
                  "kind"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "sourceThreadId": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  },
                  "sourceRequestId": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  },
                  "kind": {
                    "type": "string",
                    "const": "fork"
                  }
                },
                "required": [
                  "sourceThreadId",
                  "sourceRequestId",
                  "kind"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "sourceThreadId": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  },
                  "sourceRequestId": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  },
                  "kind": {
                    "type": "string",
                    "const": "merge"
                  }
                },
                "required": [
                  "sourceThreadId",
                  "sourceRequestId",
                  "kind"
                ],
                "additionalProperties": false
              }
            ]
          },
          "plan": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "protocolVersion": {
                    "type": "string",
                    "enum": [
                      "1.0.0",
                      "1.1.0",
                      "1.2.0",
                      "1.3.0",
                      "1.4.0",
                      "1.5.0"
                    ]
                  },
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "revision": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "rootStepId": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                  },
                  "steps": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                        },
                        "parentId": {
                          "anyOf": [
                            {
                              "type": "string",
                              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "order": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "dependsOn": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                          }
                        },
                        "title": {
                          "type": "string",
                          "minLength": 1
                        },
                        "intent": {
                          "type": "string",
                          "minLength": 1
                        },
                        "explanation": {
                          "type": "string",
                          "minLength": 1
                        },
                        "state": {
                          "type": "string",
                          "enum": [
                            "draft",
                            "ready",
                            "running",
                            "waiting_approval",
                            "verifying",
                            "succeeded",
                            "failed",
                            "stale",
                            "rolled_back"
                          ]
                        },
                        "action": {
                          "anyOf": [
                            {
                              "type": "object",
                              "properties": {
                                "adapterId": {
                                  "type": "string",
                                  "minLength": 1
                                },
                                "name": {
                                  "type": "string",
                                  "minLength": 1
                                },
                                "arguments": {
                                  "type": "object",
                                  "propertyNames": {
                                    "type": "string"
                                  },
                                  "additionalProperties": {}
                                }
                              },
                              "required": [
                                "adapterId",
                                "name",
                                "arguments"
                              ],
                              "additionalProperties": false
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "anchors": {
                          "type": "array",
                          "items": {
                            "oneOf": [
                              {
                                "type": "object",
                                "properties": {
                                  "kind": {
                                    "type": "string",
                                    "const": "object"
                                  },
                                  "objectName": {
                                    "type": "string",
                                    "minLength": 1
                                  }
                                },
                                "required": [
                                  "kind",
                                  "objectName"
                                ],
                                "additionalProperties": false
                              },
                              {
                                "type": "object",
                                "properties": {
                                  "kind": {
                                    "type": "string",
                                    "const": "world_position"
                                  },
                                  "position": {
                                    "minItems": 3,
                                    "maxItems": 3,
                                    "type": "array",
                                    "items": {
                                      "type": "number"
                                    }
                                  }
                                },
                                "required": [
                                  "kind",
                                  "position"
                                ],
                                "additionalProperties": false
                              },
                              {
                                "type": "object",
                                "properties": {
                                  "kind": {
                                    "type": "string",
                                    "const": "operator"
                                  },
                                  "operatorId": {
                                    "type": "string",
                                    "minLength": 1
                                  },
                                  "menuPath": {
                                    "type": "array",
                                    "items": {
                                      "type": "string",
                                      "minLength": 1
                                    }
                                  }
                                },
                                "required": [
                                  "kind",
                                  "operatorId"
                                ],
                                "additionalProperties": false
                              },
                              {
                                "type": "object",
                                "properties": {
                                  "kind": {
                                    "type": "string",
                                    "const": "owned_control"
                                  },
                                  "surfaceId": {
                                    "type": "string",
                                    "minLength": 1
                                  },
                                  "controlId": {
                                    "type": "string",
                                    "minLength": 1
                                  }
                                },
                                "required": [
                                  "kind",
                                  "surfaceId",
                                  "controlId"
                                ],
                                "additionalProperties": false
                              },
                              {
                                "type": "object",
                                "properties": {
                                  "kind": {
                                    "type": "string",
                                    "const": "unavailable"
                                  },
                                  "reason": {
                                    "type": "string",
                                    "minLength": 1
                                  }
                                },
                                "required": [
                                  "kind",
                                  "reason"
                                ],
                                "additionalProperties": false
                              }
                            ]
                          }
                        },
                        "expectedObservations": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "kind": {
                                "type": "string",
                                "minLength": 1
                              },
                              "parameters": {
                                "type": "object",
                                "propertyNames": {
                                  "type": "string"
                                },
                                "additionalProperties": {}
                              }
                            },
                            "required": [
                              "kind",
                              "parameters"
                            ],
                            "additionalProperties": false
                          }
                        },
                        "observationPolicy": {
                          "oneOf": [
                            {
                              "type": "object",
                              "properties": {
                                "mode": {
                                  "type": "string",
                                  "const": "telemetry"
                                }
                              },
                              "required": [
                                "mode"
                              ],
                              "additionalProperties": false
                            },
                            {
                              "type": "object",
                              "properties": {
                                "mode": {
                                  "type": "string",
                                  "const": "success_gate"
                                },
                                "failureStrategy": {
                                  "type": "string",
                                  "enum": [
                                    "rollback_step",
                                    "retain_for_repair"
                                  ]
                                }
                              },
                              "required": [
                                "mode",
                                "failureStrategy"
                              ],
                              "additionalProperties": false
                            }
                          ]
                        },
                        "rollback": {
                          "type": "object",
                          "properties": {
                            "mode": {
                              "type": "string",
                              "enum": [
                                "native_undo",
                                "checkpoint_restore",
                                "compensating_action",
                                "unsupported"
                              ]
                            },
                            "checkpointRequired": {
                              "type": "boolean"
                            }
                          },
                          "required": [
                            "mode",
                            "checkpointRequired"
                          ],
                          "additionalProperties": false
                        }
                      },
                      "required": [
                        "id",
                        "parentId",
                        "order",
                        "dependsOn",
                        "title",
                        "intent",
                        "explanation",
                        "state",
                        "action",
                        "anchors",
                        "expectedObservations",
                        "rollback"
                      ],
                      "additionalProperties": false,
                      "allOf": [
                        {
                          "if": {
                            "required": [
                              "observationPolicy"
                            ]
                          },
                          "then": {
                            "properties": {
                              "action": {
                                "type": "object"
                              }
                            }
                          }
                        },
                        {
                          "if": {
                            "properties": {
                              "observationPolicy": {
                                "properties": {
                                  "mode": {
                                    "const": "success_gate"
                                  }
                                },
                                "required": [
                                  "mode"
                                ]
                              }
                            },
                            "required": [
                              "observationPolicy"
                            ]
                          },
                          "then": {
                            "properties": {
                              "expectedObservations": {
                                "minItems": 1
                              }
                            }
                          }
                        }
                      ]
                    }
                  }
                },
                "required": [
                  "protocolVersion",
                  "id",
                  "revision",
                  "title",
                  "rootStepId",
                  "steps"
                ],
                "additionalProperties": false,
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "protocolVersion": {
                          "enum": [
                            "1.2.0",
                            "1.3.0",
                            "1.4.0",
                            "1.5.0"
                          ]
                        }
                      },
                      "required": [
                        "protocolVersion"
                      ]
                    },
                    "else": {
                      "properties": {
                        "steps": {
                          "items": {
                            "not": {
                              "required": [
                                "observationPolicy"
                              ]
                            }
                          }
                        }
                      }
                    }
                  }
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "planContentSha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          }
        },
        "required": [
          "threadId",
          "headRequestId",
          "headTurn",
          "status",
          "operation",
          "plan",
          "planContentSha256",
          "occurredAt"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "protocolVersion",
    "targetAdapterId",
    "instanceId",
    "planId",
    "branches"
  ],
  "additionalProperties": false,
  "$id": "https://operatingline.dev/schema/v1/guide-revision-branch-list.json"
}
