{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "formatVersion": {
      "type": "string",
      "const": "1.1.0"
    },
    "analysisRequestId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "analysisJobId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "request": {
      "type": "object",
      "properties": {
        "targetAdapterId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180,
          "pattern": "^\\S+$"
        },
        "actionCatalogVersion": {
          "type": "string",
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
        },
        "interactionCatalogVersion": {
          "type": "string",
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
        },
        "goal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000,
          "pattern": "\\S"
        },
        "treeId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "revision": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "locale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^\\S+$"
        }
      },
      "required": [
        "targetAdapterId",
        "goal",
        "treeId",
        "revision"
      ],
      "additionalProperties": false
    },
    "video": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "\\S"
        },
        "uri": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "^https:\\/\\/[^\\s]+$"
            },
            {
              "type": "string",
              "pattern": "^operatingline-media:\\/\\/sha256\\/[a-f0-9]{64}$"
            }
          ]
        }
      },
      "required": [
        "title",
        "uri"
      ],
      "additionalProperties": false
    },
    "source": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "authorized_youtube_download"
            },
            "videoId": {
              "type": "string",
              "minLength": 11,
              "maxLength": 11,
              "pattern": "^[A-Za-z0-9_-]{11}$"
            },
            "sourceIdentitySha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "contentSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "rightsBasis": {
              "type": "string",
              "enum": [
                "rights_holder_permission",
                "license_verified",
                "public_domain_verified"
              ]
            },
            "rightsValidation": {
              "type": "object",
              "properties": {
                "authorityId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 180,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
                },
                "receiptContentSha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "authorityContentSha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "authorityKind": {
                  "type": "string",
                  "const": "media_rights_authority"
                },
                "sideEffect": {
                  "type": "string",
                  "const": "rights_validation"
                }
              },
              "required": [
                "authorityId",
                "receiptContentSha256",
                "authorityContentSha256",
                "authorityKind",
                "sideEffect"
              ],
              "additionalProperties": false
            },
            "platformDownloadValidation": {
              "type": "object",
              "properties": {
                "authorityId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 180,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
                },
                "receiptContentSha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "authorityContentSha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "authorityKind": {
                  "type": "string",
                  "const": "youtube_platform_authority"
                },
                "sideEffect": {
                  "type": "string",
                  "const": "youtube_media_download"
                }
              },
              "required": [
                "authorityId",
                "receiptContentSha256",
                "authorityContentSha256",
                "authorityKind",
                "sideEffect"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "kind",
            "videoId",
            "sourceIdentitySha256",
            "contentSha256",
            "rightsBasis",
            "rightsValidation",
            "platformDownloadValidation"
          ],
          "additionalProperties": false,
          "$comment": "Role-specific authorityKind and sideEffect literals prevent receipt substitution in JSON Schema. Runtime Zod parsing additionally requires distinct receipt hashes, authority hashes, and authority ids."
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "user_supplied_local_file"
            },
            "sourceIdentitySha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "contentSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "rightsBasis": {
              "type": "string",
              "enum": [
                "rights_holder_permission",
                "license_verified",
                "public_domain_verified"
              ]
            },
            "importValidation": {
              "type": "object",
              "properties": {
                "authorityId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 180,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
                },
                "receiptContentSha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "authorityContentSha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "authorityKind": {
                  "type": "string",
                  "const": "local_import_authority"
                },
                "sideEffect": {
                  "type": "string",
                  "const": "local_media_import"
                }
              },
              "required": [
                "authorityId",
                "receiptContentSha256",
                "authorityContentSha256",
                "authorityKind",
                "sideEffect"
              ],
              "additionalProperties": false
            },
            "rightsValidation": {
              "type": "object",
              "properties": {
                "authorityId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 180,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
                },
                "receiptContentSha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "authorityContentSha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "authorityKind": {
                  "type": "string",
                  "const": "media_rights_authority"
                },
                "sideEffect": {
                  "type": "string",
                  "const": "rights_validation"
                }
              },
              "required": [
                "authorityId",
                "receiptContentSha256",
                "authorityContentSha256",
                "authorityKind",
                "sideEffect"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "kind",
            "sourceIdentitySha256",
            "contentSha256",
            "rightsBasis",
            "importValidation",
            "rightsValidation"
          ],
          "additionalProperties": false,
          "$comment": "Role-specific authorityKind and sideEffect literals prevent receipt substitution in JSON Schema. Runtime Zod parsing additionally requires distinct receipt hashes, authority hashes, and authority ids."
        }
      ]
    }
  },
  "required": [
    "formatVersion",
    "analysisRequestId",
    "analysisJobId",
    "request",
    "video",
    "source"
  ],
  "additionalProperties": false,
  "$id": "https://operatingline.dev/schema/v1/procedure-tutorial-media-authoring-prepare-request.json"
}
