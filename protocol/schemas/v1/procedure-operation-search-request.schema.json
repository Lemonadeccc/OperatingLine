{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "treeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "revision": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "adapterId": {
      "type": "string",
      "minLength": 1
    },
    "leafId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "operationId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "modality": {
      "type": "string",
      "enum": [
        "semantic",
        "menu",
        "shortcut",
        "mcp"
      ]
    },
    "operationKind": {
      "type": "string",
      "enum": [
        "semantic_action",
        "menu_interaction",
        "shortcut_key_input",
        "operator_property_update",
        "mcp_call"
      ]
    },
    "validationStatus": {
      "type": "string",
      "enum": [
        "candidate",
        "verified",
        "rejected"
      ]
    },
    "actionName": {
      "type": "string",
      "minLength": 1
    },
    "semanticAction": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "menuTargetHostId": {
      "type": "string",
      "minLength": 1
    },
    "menuPath": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "shortcutKeys": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "targetHostId": {
      "type": "string",
      "minLength": 1
    },
    "interactionPath": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "surfaceOperationId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "expectedOperatorId": {
      "type": "string",
      "minLength": 1
    },
    "mcpServerName": {
      "type": "string",
      "minLength": 1
    },
    "mcpToolName": {
      "type": "string",
      "minLength": 1
    },
    "afterSequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    }
  },
  "additionalProperties": false,
  "anyOf": [
    {
      "required": [
        "treeId"
      ]
    },
    {
      "required": [
        "adapterId"
      ]
    },
    {
      "required": [
        "leafId"
      ]
    },
    {
      "required": [
        "operationId"
      ]
    },
    {
      "required": [
        "modality"
      ]
    },
    {
      "required": [
        "operationKind"
      ]
    },
    {
      "required": [
        "validationStatus"
      ]
    },
    {
      "required": [
        "actionName"
      ]
    },
    {
      "required": [
        "semanticAction"
      ]
    },
    {
      "required": [
        "menuTargetHostId"
      ]
    },
    {
      "required": [
        "menuPath"
      ]
    },
    {
      "required": [
        "shortcutKeys"
      ]
    },
    {
      "required": [
        "targetHostId"
      ]
    },
    {
      "required": [
        "interactionPath"
      ]
    },
    {
      "required": [
        "surfaceOperationId"
      ]
    },
    {
      "required": [
        "expectedOperatorId"
      ]
    },
    {
      "required": [
        "mcpServerName"
      ]
    },
    {
      "required": [
        "mcpToolName"
      ]
    }
  ],
  "allOf": [
    {
      "if": {
        "required": [
          "revision"
        ]
      },
      "then": {
        "required": [
          "treeId"
        ]
      }
    }
  ],
  "$id": "https://operatingline.dev/schema/v1/procedure-operation-search-request.json"
}
