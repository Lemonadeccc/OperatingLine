{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "targetAdapterId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180
    },
    "planId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180
    },
    "instanceId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "afterSequence": {
      "default": 0,
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "limit": {
      "default": 250,
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 1000
    }
  },
  "required": [
    "targetAdapterId",
    "planId",
    "afterSequence",
    "limit"
  ],
  "additionalProperties": false,
  "$id": "https://operatingline.dev/schema/v1/eval-export-request.json"
}
