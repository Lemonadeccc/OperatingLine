          "maximum": 1000
        },
        "afterSequence": {
          "default": 0,
          "type": "number",
          "const": 0
        },
        "snapshotId": {
          "not": {}
        },
        "snapshotUpperSequence": {
          "not": {}
        }
      },
      "required": [
        "targetAdapterId",
        "planId",
        "limit",
        "afterSequence"
      ],
      "additionalProperties": false
    },
