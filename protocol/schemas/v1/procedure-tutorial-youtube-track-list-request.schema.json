{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "formatVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "requestId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "youtube": {
      "type": "object",
      "properties": {
        "videoId": {
          "type": "string",
          "minLength": 11,
          "maxLength": 11,
          "pattern": "^[A-Za-z0-9_-]{11}$"
        },
        "authorization": {
          "type": "object",
          "properties": {
            "networkFetchApproved": {
              "type": "boolean",
              "const": true
            },
            "quotaCostAcknowledged": {
              "type": "boolean",
              "const": true
            },
            "videoEditPermissionExpected": {
              "type": "boolean",
              "const": true
            }
          },
          "required": [
            "networkFetchApproved",
            "quotaCostAcknowledged",
            "videoEditPermissionExpected"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "videoId",
        "authorization"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "formatVersion",
    "requestId",
    "youtube"
  ],
  "additionalProperties": false,
  "$id": "https://operatingline.dev/schema/v1/procedure-tutorial-youtube-track-list-request.json"
}
