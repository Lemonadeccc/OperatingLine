{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "formatVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "requestId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "targetAdapterId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180,
      "pattern": "^\\S+$"
    },
    "actionCatalogVersion": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
    },
    "interactionCatalogVersion": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
    },
    "goal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000,
      "pattern": "\\S"
    },
    "treeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "revision": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "locale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^\\S+$"
    },
    "youtube": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "videoId": {
              "type": "string",
              "minLength": 11,
              "maxLength": 11,
              "pattern": "^[A-Za-z0-9_-]{11}$"
            },
            "captionTrackId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "pattern": "^\\S+$"
            },
            "requestedFormat": {
              "type": "string",
              "enum": [
                "webvtt",
                "srt"
              ]
            },
            "expectedTrackLanguage": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^\\S+$"
            },
            "defaultConfidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "authorization": {
              "type": "object",
              "properties": {
                "networkFetchApproved": {
                  "type": "boolean",
                  "const": true
                },
                "quotaCostAcknowledged": {
                  "type": "boolean",
                  "const": true
                },
                "videoEditPermissionExpected": {
                  "type": "boolean",
                  "const": true
                }
              },
              "required": [
                "networkFetchApproved",
                "quotaCostAcknowledged",
                "videoEditPermissionExpected"
              ],
              "additionalProperties": false
            },
            "rightsStatus": {
              "type": "string",
              "const": "permission_granted"
            },
            "license": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000,
              "pattern": "\\S"
            }
          },
          "required": [
            "videoId",
            "captionTrackId",
            "requestedFormat",
            "defaultConfidence",
            "authorization",
            "rightsStatus"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "videoId": {
              "type": "string",
              "minLength": 11,
              "maxLength": 11,
              "pattern": "^[A-Za-z0-9_-]{11}$"
            },
            "captionTrackId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "pattern": "^\\S+$"
            },
            "requestedFormat": {
              "type": "string",
              "enum": [
                "webvtt",
                "srt"
              ]
            },
            "expectedTrackLanguage": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^\\S+$"
            },
            "defaultConfidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "authorization": {
              "type": "object",
              "properties": {
                "networkFetchApproved": {
                  "type": "boolean",
                  "const": true
                },
                "quotaCostAcknowledged": {
                  "type": "boolean",
                  "const": true
                },
                "videoEditPermissionExpected": {
                  "type": "boolean",
                  "const": true
                }
              },
              "required": [
                "networkFetchApproved",
                "quotaCostAcknowledged",
                "videoEditPermissionExpected"
              ],
              "additionalProperties": false
            },
            "rightsStatus": {
              "type": "string",
              "const": "license_verified"
            },
            "license": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000,
              "pattern": "\\S"
            }
          },
          "required": [
            "videoId",
            "captionTrackId",
            "requestedFormat",
            "defaultConfidence",
            "authorization",
            "rightsStatus",
            "license"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "videoId": {
              "type": "string",
              "minLength": 11,
              "maxLength": 11,
              "pattern": "^[A-Za-z0-9_-]{11}$"
            },
            "captionTrackId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "pattern": "^\\S+$"
            },
            "requestedFormat": {
              "type": "string",
              "enum": [
                "webvtt",
                "srt"
              ]
            },
            "expectedTrackLanguage": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^\\S+$"
            },
            "defaultConfidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "authorization": {
              "type": "object",
              "properties": {
                "networkFetchApproved": {
                  "type": "boolean",
                  "const": true
                },
                "quotaCostAcknowledged": {
                  "type": "boolean",
                  "const": true
                },
                "videoEditPermissionExpected": {
                  "type": "boolean",
                  "const": true
                }
              },
              "required": [
                "networkFetchApproved",
                "quotaCostAcknowledged",
                "videoEditPermissionExpected"
              ],
              "additionalProperties": false
            },
            "rightsStatus": {
              "type": "string",
              "const": "public_domain"
            },
            "license": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000,
              "pattern": "\\S"
            }
          },
          "required": [
            "videoId",
            "captionTrackId",
            "requestedFormat",
            "defaultConfidence",
            "authorization",
            "rightsStatus"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "formatVersion",
    "requestId",
    "targetAdapterId",
    "goal",
    "treeId",
    "revision",
    "youtube"
  ],
  "additionalProperties": false,
  "$id": "https://operatingline.dev/schema/v1/procedure-tutorial-youtube-import-request.json"
}
