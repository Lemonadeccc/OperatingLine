{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "formatVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "artifactKind": {
      "type": "string",
      "const": "ui_recognition_observations"
    },
    "stage": {
      "type": "string",
      "const": "recognition"
    },
    "input": {
      "type": "object",
      "properties": {
        "frames": {
          "minItems": 1,
          "maxItems": 64,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "frameId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "frameSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "ocrArtifactSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "ocrCandidatesSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "timestampMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "frameId",
              "frameSha256",
              "ocrArtifactSha256",
              "ocrCandidatesSha256",
              "timestampMs"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "frames"
      ],
      "additionalProperties": false
    },
    "observations": {
      "type": "object",
      "properties": {
        "uiCandidates": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "candidateId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "kind": {
                "type": "string",
                "enum": [
                  "ui_element",
                  "menu",
                  "control"
                ]
              },
              "frameId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "timestampMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "normalizedLabel": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "menuId": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "controlId": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "bounds": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "y": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "width": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "height": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "required": [
                  "x",
                  "y",
                  "width",
                  "height"
                ],
                "additionalProperties": false
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "candidateId",
              "kind",
              "frameId",
              "timestampMs",
              "label",
              "normalizedLabel",
              "menuId",
              "controlId",
              "bounds",
              "confidence"
            ],
            "additionalProperties": false
          }
        },
        "keyCandidates": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "candidateId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "kind": {
                "type": "string",
                "const": "key_chord"
              },
              "frameId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "timestampMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "normalizedKeys": {
                "minItems": 1,
                "maxItems": 8,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "candidateId",
              "kind",
              "frameId",
              "timestampMs",
              "label",
              "normalizedKeys",
              "confidence"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "uiCandidates",
        "keyCandidates"
      ],
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "adapterId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "adapterVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "modelId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "modelVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "executableSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "modelSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "licenseId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "licenseSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "configSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "versionOutputSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "locale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "platform": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "isolationBackendId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "isolationBackendVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "isolationBackendVersionSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "supervisorSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "isolationPolicySha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "isolationAttestationSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "adapterId",
        "adapterVersion",
        "modelId",
        "modelVersion",
        "executableSha256",
        "modelSha256",
        "licenseId",
        "licenseSha256",
        "configSha256",
        "versionOutputSha256",
        "locale",
        "platform",
        "isolationBackendId",
        "isolationBackendVersion",
        "isolationBackendVersionSha256",
        "supervisorSha256",
        "isolationPolicySha256",
        "isolationAttestationSha256"
      ],
      "additionalProperties": false
    },
    "contentSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "formatVersion",
    "artifactKind",
    "stage",
    "input",
    "observations",
    "provenance",
    "contentSha256"
  ],
  "additionalProperties": false,
  "$comment": "Candidate and frame id uniqueness, candidate frame/timestamp references, normalized labels and key chords, normalized bounds containment, UTF-8 byte limits, and contentSha256 integrity require the exported Zod/service semantic validation gates; standard JSON Schema covers the strict structural contract.",
  "$id": "https://operatingline.dev/schema/v1/procedure-tutorial-media-ui-recognition-artifact.json"
}
