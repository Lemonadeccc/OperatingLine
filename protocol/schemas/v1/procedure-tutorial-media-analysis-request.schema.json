{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "formatVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "requestId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "videoId": {
      "type": "string",
      "minLength": 11,
      "maxLength": 11,
      "pattern": "^[A-Za-z0-9_-]{11}$"
    },
    "analysisProfile": {
      "type": "string",
      "const": "youtube_tutorial_evidence_v1"
    },
    "locale": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$"
    },
    "analysisWindow": {
      "type": "object",
      "properties": {
        "startMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400000
        },
        "endMs": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 86400000
        }
      },
      "required": [
        "startMs",
        "endMs"
      ],
      "additionalProperties": false
    },
    "requestedStages": {
      "type": "array",
      "items": [
        {
          "type": "string",
          "const": "download"
        },
        {
          "type": "string",
          "const": "probe"
        },
        {
          "type": "string",
          "const": "audio"
        },
        {
          "type": "string",
          "const": "asr"
        },
        {
          "type": "string",
          "const": "frames"
        },
        {
          "type": "string",
          "const": "ocr"
        },
        {
          "type": "string",
          "const": "segmentation"
        }
      ],
      "additionalItems": false,
      "minItems": 7,
      "maxItems": 7
    },
    "rightsAuthorization": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "basis": {
              "type": "string",
              "const": "rights_holder_permission"
            },
            "reference": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
            },
            "confirmedAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
            }
          },
          "required": [
            "basis",
            "reference",
            "confirmedAt"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "basis": {
              "type": "string",
              "const": "license_verified"
            },
            "reference": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
            },
            "confirmedAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
            }
          },
          "required": [
            "basis",
            "reference",
            "confirmedAt"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "basis": {
              "type": "string",
              "const": "public_domain_verified"
            },
            "reference": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
            },
            "confirmedAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
            }
          },
          "required": [
            "basis",
            "reference",
            "confirmedAt"
          ],
          "additionalProperties": false
        }
      ]
    },
    "platformDownloadAuthorization": {
      "type": "object",
      "properties": {
        "basis": {
          "type": "string",
          "const": "youtube_written_approval"
        },
        "reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "confirmedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        }
      },
      "required": [
        "basis",
        "reference",
        "confirmedAt"
      ],
      "additionalProperties": false
    },
    "approvals": {
      "type": "object",
      "properties": {
        "networkAccessApproved": {
          "type": "boolean",
          "const": true
        },
        "mediaDownloadApproved": {
          "type": "boolean",
          "const": true
        },
        "retentionApproved": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "networkAccessApproved",
        "mediaDownloadApproved",
        "retentionApproved"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "formatVersion",
    "requestId",
    "videoId",
    "analysisProfile",
    "locale",
    "analysisWindow",
    "requestedStages",
    "rightsAuthorization",
    "platformDownloadAuthorization",
    "approvals"
  ],
  "additionalProperties": false,
  "$id": "https://operatingline.dev/schema/v1/procedure-tutorial-media-analysis-request.json"
}
