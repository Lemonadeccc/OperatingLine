              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "contentSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "rightsBasis": {
              "type": "string",
              "enum": [
                "rights_holder_permission",
                "license_verified",
                "public_domain_verified"
              ]
            },
            "rightsValidation": {
              "type": "object",
              "properties": {
                "authorityId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 180,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
                },
                "receiptContentSha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "authorityContentSha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "authorityKind": {
                  "type": "string",
                  "const": "media_rights_authority"
                },
                "sideEffect": {
                  "type": "string",
                  "const": "rights_validation"
                }
              },
              "required": [
                "authorityId",
                "receiptContentSha256",
                "authorityContentSha256",
                "authorityKind",
                "sideEffect"
              ],
              "additionalProperties": false
            },
            "platformDownloadValidation": {
              "type": "object",
              "properties": {
                "authorityId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 180,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
                },
                "receiptContentSha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "authorityContentSha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "authorityKind": {
                  "type": "string",
                  "const": "youtube_platform_authority"
                },
                "sideEffect": {
                  "type": "string",
                  "const": "youtube_media_download"
                }
              },
              "required": [
                "authorityId",
                "receiptContentSha256",
                "authorityContentSha256",
                "authorityKind",
                "sideEffect"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "kind",
            "videoId",
            "sourceIdentitySha256",
            "contentSha256",
            "rightsBasis",
            "rightsValidation",
            "platformDownloadValidation"
          ],
          "additionalProperties": false,
          "$comment": "Role-specific authorityKind and sideEffect literals prevent receipt substitution in JSON Schema. Runtime Zod parsing additionally requires distinct receipt hashes, authority hashes, and authority ids."
        },
        "analysisProfile": {
          "type": "string",
          "const": "youtube_tutorial_evidence_v1"
        },
        "requestedStages": {
          "type": "array",
          "items": [
            {
              "type": "string",
              "const": "download"
            },
            {
              "type": "string",
              "const": "probe"
            },
            {
              "type": "string",
              "const": "audio"
            },
            {
              "type": "string",
              "const": "asr"
            },
            {
              "type": "string",
              "const": "frames"
            },
            {
              "type": "string",
              "const": "ocr"
            },
            {
              "type": "string",
              "const": "segmentation"
            }
          ],
          "additionalItems": false,
          "minItems": 7,
          "maxItems": 7
        },
        "approvals": {
          "type": "object",
          "properties": {
            "networkAccessApproved": {
              "type": "boolean",
              "const": true
            },
            "mediaDownloadApproved": {
              "type": "boolean",
              "const": true
            },
            "retentionApproved": {
              "type": "boolean",
              "const": true
            }
          },
          "required": [
            "networkAccessApproved",
            "mediaDownloadApproved",
            "retentionApproved"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "formatVersion",
        "requestId",
        "locale",
        "analysisWindow",
        "source",
        "analysisProfile",
        "requestedStages",
        "approvals"
      ],
      "additionalProperties": false
    },
