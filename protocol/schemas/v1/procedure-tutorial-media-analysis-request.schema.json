          "maxLength": 64,
          "pattern": "^[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$"
        },
        "analysisWindow": {
          "type": "object",
          "properties": {
            "startMs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 86400000
            },
            "endMs": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 86400000
