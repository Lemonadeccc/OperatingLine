              "isLarge": {
                "type": "boolean"
              },
              "isEasyReader": {
                "type": "boolean"
              },
              "isDraft": {
                "type": "boolean"
              },
              "isAutoSynced": {
                "type": "boolean"
              },
              "status": {
                "type": "string",
