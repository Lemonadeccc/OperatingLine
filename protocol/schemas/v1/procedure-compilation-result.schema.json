              "observationPolicy": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "mode": {
                        "type": "string",
                        "const": "telemetry"
                      }
                    },
                    "required": [
                      "mode"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "mode": {
                        "type": "string",
                        "const": "success_gate"
                      },
                      "failureStrategy": {
                        "type": "string",
                        "enum": [
                          "rollback_step",
                          "retain_for_repair"
                        ]
                      },
                      "retryPolicy": {
                        "type": "object",
                        "properties": {
                          "mode": {
                            "type": "string",
                            "const": "automatic_bounded"
                          },
                          "maxAttempts": {
                            "type": "integer",
                            "minimum": 2,
                            "maximum": 3
                          }
                        },
                        "required": [
                          "mode",
                          "maxAttempts"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "mode",
                      "failureStrategy"
                    ],
                    "additionalProperties": false,
                    "allOf": [
                      {
                        "if": {
                          "required": [
                            "retryPolicy"
                          ]
                        },
                        "then": {
                          "properties": {
                            "failureStrategy": {
                              "const": "rollback_step"
                            }
                          }
                        }
                      }
                    ]
                  }
                ]
              },
              "executionTrackOverride": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "interaction_catalog_proof"
                  },
                  "interactionCatalogVersion": {
                    "type": "string",
                    "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
                  },
                  "interactionCatalogContentSha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "recipeId": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                  },
                  "modality": {
                    "type": "string",
                    "enum": [
                      "menu",
                      "shortcut"
                    ]
                  },
                  "trackId": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                  },
                  "trackContentSha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "proofExecutionContentSha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "kind",
                  "interactionCatalogVersion",
                  "interactionCatalogContentSha256",
                  "recipeId",
                  "modality",
                  "trackId",
                  "trackContentSha256",
                  "proofExecutionContentSha256"
                ],
                "additionalProperties": false
              },
              "candidateMenuProjection": {
                "type": "object",
                "properties": {
                  "projection": {
                    "type": "string",
                    "const": "candidate_only"
                  },
                  "interactionCatalogVersion": {
                    "type": "string",
                    "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
                  },
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                  },
                  "modality": {
                    "type": "string",
                    "const": "menu"
                  },
                  "equivalence": {
                    "type": "string",
                    "const": "not_equivalent_to_managed_action"
                  },
                  "executionAuthority": {
                    "type": "string",
                    "const": "none"
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  },
                  "preconditions": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "enum": [
                            "workspace",
                            "editor",
                            "mode",
                            "selection",
                            "keymap",
                            "modal_state",
                            "scene_state"
                          ]
                        },
                        "label": {
                          "type": "string",
                          "minLength": 1
                        },
                        "value": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "kind",
                        "label",
                        "value"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "operations": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                        },
                        "order": {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 9007199254740991
                        },
                        "semanticRefs": {
                          "minItems": 1,
                          "type": "array",
                          "items": {
                            "type": "string",
                            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                          }
                        },
                        "description": {
                          "type": "string",
                          "minLength": 1
                        },
                        "evidenceRefs": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                          }
                        },
                        "intent": {
                          "type": "string",
                          "enum": [
                            "navigate",
                            "configure",
                            "execute",
                            "verify"
                          ]
                        },
                        "target": {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "type": "string",
                              "enum": [
                                "workspace",
                                "editor",
                                "mode",
                                "menu",
                                "menu_item",
                                "operator",
                                "control",
                                "panel",
                                "node",
                                "socket",
                                "canvas",
                                "semantic"
                              ]
                            },
                            "hostId": {
                              "type": "string",
                              "minLength": 1
                            },
                            "connection": {
                              "type": "object",
                              "properties": {
                                "fromNode": {
                                  "type": "string",
                                  "minLength": 1
                                },
                                "fromSocket": {
                                  "type": "string",
                                  "minLength": 1
                                },
                                "toNode": {
                                  "type": "string",
                                  "minLength": 1
                                },
                                "toSocket": {
                                  "type": "string",
                                  "minLength": 1
                                }
                              },
                              "required": [
                                "fromNode",
                                "fromSocket",
                                "toNode",
                                "toSocket"
                              ],
                              "additionalProperties": false
                            }
                          },
                          "required": [
                            "kind",
                            "hostId"
                          ],
                          "additionalProperties": false
                        },
                        "path": {
                          "minItems": 1,
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "parameters": {
                          "type": "object",
                          "propertyNames": {
                            "type": "string",
                            "minLength": 1
                          },
                          "additionalProperties": {
                            "$ref": "#/$defs/__schema0"
                          }
                        }
                      },
                      "required": [
                        "id",
                        "order",
                        "semanticRefs",
                        "description",
                        "evidenceRefs",
                        "intent",
                        "target",
                        "path",
                        "parameters"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "omittedActionArguments": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "argumentName": {
                          "type": "string",
                          "minLength": 1
                        },
                        "reason": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "argumentName",
                        "reason"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "nativeEvidence": {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "bounded_blender_ui_probe"
                      },
                      "executorId": {
                        "type": "string",
                        "minLength": 1
                      },
                      "hostVersions": {
                        "minItems": 1,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "managedActionExecuted": {
                        "type": "boolean",
                        "const": false
                      },
                      "managedReceiptCreated": {
                        "type": "boolean",
                        "const": false
                      },
                      "managedReplacementMeshCreated": {
                        "type": "boolean",
                        "const": false
                      },
                      "nativeMutationKind": {
                        "type": "string",
                        "minLength": 1
                      },
                      "operationIds": {
                        "minItems": 1,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                        }
                      },
                      "nativeUndoCheckpointRequired": {
                        "type": "boolean",
                        "const": true
                      },
                      "nativeUndoDepth": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 9007199254740991
                      },
                      "nativeRedoDepth": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": [
                      "kind",
                      "executorId",
                      "hostVersions",
                      "managedActionExecuted",
                      "managedReceiptCreated",
                      "managedReplacementMeshCreated",
                      "nativeMutationKind",
                      "operationIds",
                      "nativeUndoCheckpointRequired",
                      "nativeUndoDepth",
                      "nativeRedoDepth"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "projection",
                  "interactionCatalogVersion",
                  "id",
                  "modality",
                  "equivalence",
                  "executionAuthority",
                  "title",
                  "reason",
                  "preconditions",
                  "operations",
                  "omittedActionArguments"
                ],
                "additionalProperties": false
              },
              "rollback": {
                "type": "object",
                "properties": {
                  "mode": {
                    "type": "string",
                    "enum": [
                      "native_undo",
                      "checkpoint_restore",
                      "compensating_action",
                      "unsupported"
                    ]
                  },
                  "checkpointRequired": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "mode",
                  "checkpointRequired"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "parentId",
              "order",
              "dependsOn",
              "title",
              "intent",
              "explanation",
              "state",
              "action",
              "anchors",
              "expectedObservations",
              "rollback"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "required": [
                    "observationPolicy"
                  ]
                },
                "then": {
                  "properties": {
                    "action": {
                      "type": "object"
                    }
                  }
                }
              },
              {
                "if": {
                  "required": [
                    "executionTrackOverride"
                  ]
                },
                "then": {
                  "properties": {
                    "action": {
                      "type": "object"
                    }
                  }
                }
              },
              {
                "if": {
                  "required": [
                    "candidateMenuProjection"
                  ]
                },
                "then": {
                  "properties": {
                    "action": {
                      "type": "object"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "observationPolicy": {
                      "properties": {
                        "mode": {
                          "const": "success_gate"
                        }
                      },
                      "required": [
                        "mode"
                      ]
                    }
                  },
                  "required": [
                    "observationPolicy"
                  ]
                },
                "then": {
                  "properties": {
                    "expectedObservations": {
                      "minItems": 1
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "required": [
        "protocolVersion",
        "id",
        "revision",
        "title",
        "rootStepId",
        "steps"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "protocolVersion": {
                "enum": [
                  "1.2.0",
                  "1.3.0",
                  "1.4.0",
                  "1.5.0",
                  "1.6.0",
                  "1.7.0"
                ]
              }
            },
            "required": [
              "protocolVersion"
            ]
          },
          "else": {
            "properties": {
              "steps": {
                "items": {
                  "not": {
                    "required": [
                      "observationPolicy"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "protocolVersion": {
                "enum": [
                  "1.6.0",
                  "1.7.0"
                ]
              }
            },
            "required": [
              "protocolVersion"
            ]
          },
          "else": {
            "properties": {
              "steps": {
                "items": {
                  "not": {
                    "required": [
                      "executionTrackOverride"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "protocolVersion": {
                "const": "1.7.0"
              }
            },
            "required": [
              "protocolVersion"
            ]
          },
          "else": {
            "properties": {
              "steps": {
                "items": {
                  "not": {
                    "required": [
                      "candidateMenuProjection"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "protocolVersion": {
                "enum": [
                  "1.0.0",
                  "1.1.0",
                  "1.2.0",
                  "1.3.0",
                  "1.4.0"
                ]
              }
            },
            "required": [
              "protocolVersion"
            ]
          },
          "then": {
            "properties": {
              "steps": {
                "items": {
                  "properties": {
                    "observationPolicy": {
                      "not": {
                        "required": [
                          "retryPolicy"
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "proposalCreated": {
      "type": "boolean",
      "const": false
    },
    "hostExecutionStarted": {
      "type": "boolean",
      "const": false
    }
  },
  "required": [
    "formatVersion",
    "procedureTreeId",
    "procedureTreeRevision",
    "adapterId",
    "actionCatalogVersion",
    "interactionCatalogVersion",
    "validation",
    "plan",
    "proposalCreated",
    "hostExecutionStarted"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  },
  "$id": "https://operatingline.dev/schema/v1/procedure-compilation-result.json"
}
