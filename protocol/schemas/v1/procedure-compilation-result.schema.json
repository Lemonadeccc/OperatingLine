{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "formatVersion": {
      "type": "string",
      "enum": [
        "1.0.0",
        "1.1.0",
        "1.2.0"
      ]
    },
    "procedureTreeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "procedureTreeRevision": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "adapterId": {
      "type": "string",
      "minLength": 1
    },
    "actionCatalogVersion": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
    },
    "interactionCatalogVersion": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
    },
    "validation": {
      "type": "object",
      "properties": {
        "procedureStructure": {
          "type": "string",
          "const": "validated"
        },
        "actionCatalogBinding": {
          "type": "string",
          "const": "validated"
        },
        "hostVersionRange": {
          "type": "string",
          "const": "validated_against_action_catalog"
        },
        "interactionTracks": {
          "type": "string",
          "const": "structural_only"
        }
      },
      "required": [
        "procedureStructure",
        "actionCatalogBinding",
        "hostVersionRange",
        "interactionTracks"
      ],
      "additionalProperties": false
    },
    "plan": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "type": "string",
          "enum": [
            "1.0.0",
            "1.1.0",
            "1.2.0",
            "1.3.0",
            "1.4.0",
            "1.5.0",
            "1.6.0",
            "1.7.0"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "rootStepId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "steps": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
              },
              "parentId": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "order": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "dependsOn": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                }
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "intent": {
                "type": "string",
                "minLength": 1
              },
              "explanation": {
                "type": "string",
                "minLength": 1
              },
              "state": {
                "type": "string",
                "enum": [
                  "draft",
                  "ready",
                  "running",
                  "waiting_approval",
                  "verifying",
                  "succeeded",
                  "failed",
                  "stale",
                  "rolled_back"
