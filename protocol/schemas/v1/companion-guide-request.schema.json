{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "adapterId": {
      "type": "string",
      "minLength": 1
    },
    "instanceId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "knownPlanId": {
      "type": "string",
      "minLength": 1
    },
    "knownRevision": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "knownPlanContentSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "knownProposalId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    }
  },
  "required": [
    "adapterId",
    "instanceId"
  ],
  "additionalProperties": false,
  "dependentRequired": {
    "knownPlanId": [
      "knownRevision",
      "knownPlanContentSha256"
    ],
    "knownRevision": [
      "knownPlanId",
      "knownPlanContentSha256"
    ],
    "knownPlanContentSha256": [
      "knownPlanId",
      "knownRevision"
    ]
  },
  "$id": "https://operatingline.dev/schema/v1/companion-guide-request.json"
}
