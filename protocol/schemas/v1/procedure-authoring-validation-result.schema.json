{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "formatVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "packetContentSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "validation": {
      "type": "object",
      "properties": {
        "packetIntegrity": {
          "type": "string",
          "const": "validated"
        },
        "installedCatalogBinding": {
          "type": "string",
          "const": "validated"
        },
        "authoringCandidateContract": {
          "type": "string",
          "const": "validated"
        },
        "procedureCompilation": {
          "type": "string",
          "const": "validated"
        }
      },
      "required": [
        "packetIntegrity",
        "installedCatalogBinding",
        "authoringCandidateContract",
        "procedureCompilation"
      ],
      "additionalProperties": false
    },
    "compilation": {
      "type": "object",
      "properties": {
        "formatVersion": {
          "type": "string",
          "const": "1.0.0"
        },
        "procedureTreeId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "procedureTreeRevision": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "adapterId": {
          "type": "string",
          "minLength": 1
        },
        "actionCatalogVersion": {
          "type": "string",
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
        },
        "interactionCatalogVersion": {
          "type": "string",
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
        },
        "validation": {
          "type": "object",
          "properties": {
            "procedureStructure": {
              "type": "string",
              "const": "validated"
            },
            "actionCatalogBinding": {
              "type": "string",
              "const": "validated"
            },
            "hostVersionRange": {
              "type": "string",
              "const": "validated_against_action_catalog"
            },
            "interactionTracks": {
              "type": "string",
              "const": "structural_only"
            }
          },
          "required": [
            "procedureStructure",
            "actionCatalogBinding",
            "hostVersionRange",
            "interactionTracks"
          ],
          "additionalProperties": false
        },
        "plan": {
          "type": "object",
          "properties": {
            "protocolVersion": {
              "type": "string",
              "enum": [
                "1.0.0",
                "1.1.0",
                "1.2.0",
                "1.3.0",
                "1.4.0",
                "1.5.0"
              ]
            },
            "id": {
              "type": "string",
              "minLength": 1
            },
            "revision": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "rootStepId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            },
            "steps": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                  },
                  "parentId": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "order": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "dependsOn": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                    }
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "intent": {
                    "type": "string",
                    "minLength": 1
                  },
                  "explanation": {
                    "type": "string",
                    "minLength": 1
                  },
                  "state": {
                    "type": "string",
                    "enum": [
                      "draft",
                      "ready",
                      "running",
                      "waiting_approval",
                      "verifying",
                      "succeeded",
                      "failed",
                      "stale",
                      "rolled_back"
                    ]
                  },
                  "action": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "adapterId": {
                            "type": "string",
                            "minLength": 1
                          },
                          "name": {
                            "type": "string",
                            "minLength": 1
                          },
                          "arguments": {
                            "type": "object",
                            "propertyNames": {
                              "type": "string"
                            },
                            "additionalProperties": {}
                          }
                        },
                        "required": [
                          "adapterId",
                          "name",
                          "arguments"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "anchors": {
                    "type": "array",
                    "items": {
                      "oneOf": [
                        {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "type": "string",
                              "const": "object"
                            },
                            "objectName": {
                              "type": "string",
                              "minLength": 1
                            }
                          },
                          "required": [
                            "kind",
                            "objectName"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "type": "string",
                              "const": "world_position"
                            },
                            "position": {
                              "minItems": 3,
                              "maxItems": 3,
                              "type": "array",
                              "items": {
                                "type": "number"
                              }
                            }
                          },
                          "required": [
                            "kind",
                            "position"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "type": "string",
                              "const": "operator"
                            },
                            "operatorId": {
                              "type": "string",
                              "minLength": 1
                            },
                            "menuPath": {
                              "type": "array",
                              "items": {
                                "type": "string",
                                "minLength": 1
                              }
                            }
                          },
                          "required": [
                            "kind",
                            "operatorId"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "type": "string",
                              "const": "owned_control"
                            },
                            "surfaceId": {
                              "type": "string",
                              "minLength": 1
                            },
                            "controlId": {
                              "type": "string",
                              "minLength": 1
                            }
                          },
                          "required": [
                            "kind",
                            "surfaceId",
                            "controlId"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "type": "string",
                              "const": "unavailable"
                            },
                            "reason": {
                              "type": "string",
                              "minLength": 1
                            }
                          },
                          "required": [
                            "kind",
                            "reason"
                          ],
                          "additionalProperties": false
                        }
                      ]
                    }
                  },
                  "expectedObservations": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "minLength": 1
                        },
                        "parameters": {
                          "type": "object",
                          "propertyNames": {
                            "type": "string"
                          },
                          "additionalProperties": {}
                        }
                      },
                      "required": [
                        "kind",
                        "parameters"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "observationPolicy": {
                    "oneOf": [
                      {
                        "type": "object",
                        "properties": {
                          "mode": {
                            "type": "string",
                            "const": "telemetry"
                          }
                        },
                        "required": [
                          "mode"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "mode": {
                            "type": "string",
                            "const": "success_gate"
                          },
                          "failureStrategy": {
                            "type": "string",
                            "enum": [
                              "rollback_step",
                              "retain_for_repair"
                            ]
                          }
                        },
                        "required": [
                          "mode",
                          "failureStrategy"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  },
                  "rollback": {
                    "type": "object",
                    "properties": {
                      "mode": {
                        "type": "string",
                        "enum": [
                          "native_undo",
                          "checkpoint_restore",
                          "compensating_action",
                          "unsupported"
                        ]
                      },
                      "checkpointRequired": {
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "mode",
                      "checkpointRequired"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "id",
                  "parentId",
                  "order",
                  "dependsOn",
                  "title",
                  "intent",
                  "explanation",
                  "state",
                  "action",
                  "anchors",
                  "expectedObservations",
                  "rollback"
                ],
                "additionalProperties": false,
                "allOf": [
                  {
                    "if": {
                      "required": [
                        "observationPolicy"
                      ]
                    },
                    "then": {
                      "properties": {
                        "action": {
                          "type": "object"
                        }
                      }
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "observationPolicy": {
                          "properties": {
                            "mode": {
                              "const": "success_gate"
                            }
                          },
                          "required": [
                            "mode"
                          ]
                        }
                      },
                      "required": [
                        "observationPolicy"
                      ]
                    },
                    "then": {
                      "properties": {
                        "expectedObservations": {
                          "minItems": 1
                        }
                      }
                    }
                  }
                ]
              }
            }
          },
          "required": [
            "protocolVersion",
            "id",
            "revision",
            "title",
            "rootStepId",
            "steps"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "protocolVersion": {
                    "enum": [
                      "1.2.0",
                      "1.3.0",
                      "1.4.0",
                      "1.5.0"
                    ]
                  }
                },
                "required": [
                  "protocolVersion"
                ]
              },
              "else": {
                "properties": {
                  "steps": {
                    "items": {
                      "not": {
                        "required": [
                          "observationPolicy"
                        ]
                      }
                    }
                  }
                }
              }
            }
          ]
        },
        "proposalCreated": {
          "type": "boolean",
          "const": false
        },
        "hostExecutionStarted": {
          "type": "boolean",
          "const": false
        }
      },
      "required": [
        "formatVersion",
        "procedureTreeId",
        "procedureTreeRevision",
        "adapterId",
        "actionCatalogVersion",
        "interactionCatalogVersion",
        "validation",
        "plan",
        "proposalCreated",
        "hostExecutionStarted"
      ],
      "additionalProperties": false
    },
    "procedureStored": {
      "type": "boolean",
      "const": false
    },
    "proposalCreated": {
      "type": "boolean",
      "const": false
    },
    "hostExecutionStarted": {
      "type": "boolean",
      "const": false
    }
  },
  "required": [
    "formatVersion",
    "packetContentSha256",
    "validation",
    "compilation",
    "procedureStored",
    "proposalCreated",
    "hostExecutionStarted"
  ],
  "additionalProperties": false,
  "$id": "https://operatingline.dev/schema/v1/procedure-authoring-validation-result.json"
}
