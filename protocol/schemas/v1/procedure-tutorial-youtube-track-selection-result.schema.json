                    "exact_only",
                    "primary_subtag_fallback"
                  ]
                },
                "allowUnlistedLanguages": {
                  "type": "boolean"
                },
                "trackKindPriority": {
                  "minItems": 1,
                  "maxItems": 3,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "ASR",
                      "forced",
                      "standard"
                    ]
                  }
                },
                "audioTrackTypePriority": {
                  "minItems": 1,
                  "maxItems": 4,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "commentary",
                      "descriptive",
                      "primary",
                      "unknown"
                    ]
                  }
                },
                "allowDraftTracks": {
                  "type": "boolean"
                },
                "preferClosedCaptions": {
                  "type": "boolean"
                },
                "preferManualSync": {
