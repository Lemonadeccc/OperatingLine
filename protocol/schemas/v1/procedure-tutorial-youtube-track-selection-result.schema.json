            },
            "trackKind": {
              "type": "string",
              "enum": [
                "ASR",
                "forced",
                "standard"
              ]
            },
            "language": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^\\S+$"
            },
            "name": {
              "type": "string",
              "maxLength": 150
            },
            "audioTrackType": {
              "type": "string",
              "enum": [
                "commentary",
                "descriptive",
                "primary",
                "unknown"
              ]
            },
            "isCC": {
              "type": "boolean"
            },
            "isLarge": {
              "type": "boolean"
            },
            "isEasyReader": {
              "type": "boolean"
            },
            "isDraft": {
              "type": "boolean"
            },
            "isAutoSynced": {
              "type": "boolean"
            },
            "status": {
              "type": "string",
              "const": "syncing"
            }
          },
          "required": [
            "captionTrackId",
            "lastUpdated",
            "trackKind",
            "language",
            "name",
            "audioTrackType",
            "isCC",
            "isLarge",
            "isEasyReader",
            "isDraft",
            "isAutoSynced",
            "status"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "captionTrackId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "pattern": "^\\S+$"
