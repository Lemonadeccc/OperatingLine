                  "const": true
                }
              },
              "required": [
                "preferredLanguages",
                "languageMatching",
                "allowUnlistedLanguages",
                "trackKindPriority",
                "audioTrackTypePriority",
                "allowDraftTracks",
                "preferClosedCaptions",
                "preferManualSync",
                "explicitSelectionRequired"
              ],
              "additionalProperties": false
            },
            "recommendedCaptionTrackId": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024,
                  "pattern": "^\\S+$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "selectedCandidateRank": {
              "anyOf": [
                {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "selectedTrackWasRecommended": {
              "type": "boolean"
            }
          },
          "required": [
            "preferences",
            "recommendedCaptionTrackId",
            "selectedCandidateRank",
            "selectedTrackWasRecommended"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
