            "isLarge",
            "isEasyReader",
            "isDraft",
            "isAutoSynced",
            "status"
          ],
          "additionalProperties": false
        }
      ]
    },
    "confirmation": {
      "type": "object",
      "properties": {
        "explicitlyConfirmedByUser": {
          "type": "boolean",
          "const": true
        },
        "reason": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "reasonCode": {
                  "type": "string",
                  "enum": [
                    "recommended_candidate",
                    "language_preference",
                    "caption_quality_review",
                    "accessibility_requirement",
                    "workflow_requirement"
                  ]
                },
                "note": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000,
                  "pattern": "\\S"
                }
              },
              "required": [
                "reasonCode"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "reasonCode": {
                  "type": "string",
                  "const": "other"
                },
                "note": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000,
                  "pattern": "\\S"
                }
              },
              "required": [
                "reasonCode",
                "note"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "explicitlyConfirmedByUser",
        "reason"
      ],
      "additionalProperties": false
