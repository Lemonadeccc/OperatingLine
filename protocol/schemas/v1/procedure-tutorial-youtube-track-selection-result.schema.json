    "recommendation": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "preferences": {
              "type": "object",
              "properties": {
                "preferredLanguages": {
                  "minItems": 1,
                  "maxItems": 32,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64,
                    "pattern": "^\\S+$"
