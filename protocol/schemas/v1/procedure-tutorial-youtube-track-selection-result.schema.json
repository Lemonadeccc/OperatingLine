              ]
            },
            "language": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^\\S+$"
            },
            "name": {
              "type": "string",
              "maxLength": 150
            },
            "audioTrackType": {
              "type": "string",
