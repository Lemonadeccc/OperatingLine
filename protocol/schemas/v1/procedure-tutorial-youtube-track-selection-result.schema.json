        "requestId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "videoId": {
          "type": "string",
          "minLength": 11,
          "maxLength": 11,
          "pattern": "^[A-Za-z0-9_-]{11}$"
        },
        "listedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        }
      },
      "required": [
        "requestId",
        "videoId",
        "listedAt"
      ],
      "additionalProperties": false
    },
    "selectedTrack": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "captionTrackId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "pattern": "^\\S+$"
            },
            "lastUpdated": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
            },
            "trackKind": {
              "type": "string",
              "enum": [
                "ASR",
                "forced",
                "standard"
              ]
            },
            "language": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^\\S+$"
            },
            "name": {
              "type": "string",
              "maxLength": 150
            },
            "audioTrackType": {
              "type": "string",
              "enum": [
                "commentary",
                "descriptive",
                "primary",
                "unknown"
              ]
            },
            "isCC": {
              "type": "boolean"
            },
            "isLarge": {
              "type": "boolean"
            },
            "isEasyReader": {
              "type": "boolean"
            },
            "isDraft": {
              "type": "boolean"
            },
            "isAutoSynced": {
              "type": "boolean"
            },
            "status": {
              "type": "string",
              "const": "serving"
            }
          },
          "required": [
            "captionTrackId",
            "lastUpdated",
            "trackKind",
            "language",
            "name",
            "audioTrackType",
            "isCC",
            "isLarge",
            "isEasyReader",
            "isDraft",
            "isAutoSynced",
            "status"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "captionTrackId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
