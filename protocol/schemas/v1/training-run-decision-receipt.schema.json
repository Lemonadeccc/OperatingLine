{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "formatVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "decisionId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "nonce": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{16,128}$"
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "kind": {
      "type": "string",
      "const": "TrainingRunDecisionReceipt"
    },
    "trainingUseValidationReceipt": {
      "type": "object",
      "properties": {
        "formatVersion": {
          "type": "string",
          "const": "1.0.0"
        },
        "receiptId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "authorityKind": {
          "type": "string",
          "enum": [
            "ProviderCallAuthorization",
            "LocalMediaImportAuthorization",
            "MediaRightsEvidence",
            "YouTubePlatformDownloadAuthorization",
            "DatasetReleaseAuthorization",
            "TrainingUseAuthorization"
          ]
        },
        "authorityId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "authorityContentSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "signerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
        },
        "keyId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
        },
        "registryVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
        },
        "validatedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "revocationLogHeadSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "targetSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sideEffect": {
          "type": "string",
          "enum": [
            "provider_call",
            "local_media_import",
            "media_rights_validation",
            "youtube_platform_download",
            "dataset_release",
            "training_export"
          ]
        }
      },
      "required": [
        "formatVersion",
        "receiptId",
        "authorityKind",
        "authorityId",
        "authorityContentSha256",
        "signerId",
        "keyId",
        "registryVersion",
        "validatedAt",
        "revocationLogHeadSha256",
        "targetSha256",
        "sideEffect"
      ],
      "additionalProperties": false
    },
    "releasedManifestSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "trainingExportSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "codeSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "configSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "modelFamilySha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "runId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    }
  },
  "required": [
    "formatVersion",
    "decisionId",
    "nonce",
    "issuedAt",
    "expiresAt",
    "kind",
    "trainingUseValidationReceipt",
    "releasedManifestSha256",
    "trainingExportSha256",
    "codeSha256",
    "configSha256",
    "modelFamilySha256",
    "runId"
  ],
  "additionalProperties": false,
  "$comment": "issuedAt < expiresAt and the fifteen-minute maximum validity window require the exported Zod semantic validation gate; standard JSON Schema cannot compare dynamic sibling timestamps.",
  "$id": "https://operatingline.dev/schema/v1/training-run-decision-receipt.json"
}
