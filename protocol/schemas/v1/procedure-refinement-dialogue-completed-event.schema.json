{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "formatVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "runId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "requestId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "requestFingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "providerId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "providerVersion": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
    },
    "packetContentSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "treatmentContentSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "operation": {
      "type": "string",
      "const": "procedure_refinement_dialogue"
    },
    "resultContentSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "result": {
      "type": "object",
      "properties": {
        "assistantMessage": {
          "type": "string",
          "maxLength": 4000,
          "pattern": "\\S"
        },
        "decision": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "answer"
                },
                "confidence": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0,
                      "exclusiveMaximum": 0.8
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "threshold": {
                  "type": "number",
                  "const": 0.8
                }
              },
              "required": [
                "kind",
                "confidence",
                "threshold"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "refine"
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0.8,
                  "maximum": 1
                },
                "threshold": {
                  "type": "number",
                  "const": 0.8
                }
              },
              "required": [
                "kind",
                "confidence",
                "threshold"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "assistantMessage",
        "decision"
      ],
      "additionalProperties": false
    },
    "durationMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "required": [
    "formatVersion",
    "runId",
    "requestId",
    "requestFingerprint",
    "providerId",
    "providerVersion",
    "packetContentSha256",
    "treatmentContentSha256",
    "operation",
    "resultContentSha256",
    "result",
    "durationMs",
    "occurredAt"
  ],
  "additionalProperties": false,
  "$id": "https://operatingline.dev/schema/v1/procedure-refinement-dialogue-completed-event.json"
}
